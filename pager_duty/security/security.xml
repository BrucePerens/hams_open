<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="res.groups.privilege" id="privilege_pager_duty">
            <field name="name">Pager Duty Management</field>
        </record>

        <record id="group_pager_admin" model="res.groups">
            <field name="name">Pager Duty Admin</field>
            <field name="privilege_id" ref="privilege_pager_duty"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_pager_service" model="res.groups">
            <field name="name">Pager Duty Service Account Group</field>
            <field name="privilege_id" ref="privilege_pager_duty"/>
        </record>

        <record id="group_pager_mcp_triage_service" model="res.groups">
            <!-- PAGER_DUTY_MCP_AI_TRIAGE.md's own "Real build order": a
                 narrowly-scoped service account for the MCP triage
                 server's own list_incidents/get_incident/add_incident_note
                 tools; read-only on pager.incident (see
                 ir.model.access.csv), deliberately NOT group_pager_service
                 (read/write/create), since the MCP server itself must
                 never be able to change an incident's own fields
                 (including status; set_incident_status is its own,
                 separately-gated slice, not built here). Posting a note
                 and reading chatter both go through model methods
                 (mcp_add_note/mcp_get_incident_detail on pager.incident)
                 that internally elevate to the existing
                 zero_sudo.mail_service_internal account the rest of this
                 model already uses for message_post(), so this group
                 never needs mail.message ACL of its own either. -->
            <field name="name">Pager Duty MCP Triage Service Account Group</field>
            <field name="privilege_id" ref="privilege_pager_duty"/>
        </record>

        <record id="group_pager_incident_creator" model="res.groups">
            <!-- Service-account privilege audit, 2026-09-14 (bug-hunt):
                 user_pager_incident_creator is the identity report_incident(),
                 _raise_trend_incident() and message_new() (the inbound-email
                 gateway path) elevate to, i.e. the account reachable from
                 externally-triggered, lower-trust input (any daemon's report,
                 any inbound email to info@/postmaster@, ham_relay_bridge's
                 theft-case intake). It used to hold group_pager_service, the
                 exact same group as user_pager_service_internal, so being
                 "separately named" bought no privilege reduction at all: the
                 creator could also read/write/create pager.check (heartbeat
                 monitors, Let's Encrypt domain lists) and see every
                 pager.log.file/pager.log.pattern/pager.log.search.job. Its
                 real job needs exactly read/write/create on pager.incident
                 (search for the existing same-source incident, bump its
                 occurrence window, create a new one) and nothing else, see
                 ir.model.access.csv and pager_incident_website_rule_creator. -->
            <field name="name">Pager Duty Incident Creator Service Account Group</field>
            <field name="privilege_id" ref="privilege_pager_duty"/>
        </record>

        <record id="pager_check_website_company_rule" model="ir.rule">
            <!-- A single combined rule, not two separate website/company
                 rules: multiple ir.rule records for the SAME group are
                 OR'ed together in Odoo, not AND'ed, so splitting this into
                 two rules let a record from ANY other company become
                 visible merely by having no website_id set (and vice
                 versa), a real multi-tenant isolation bypass caught by
                 test_04_multi_tenant_isolation/test_05_multi_website_isolation. -->
            <field name="name">Pager Check Multi-Website/Multi-Company</field>
            <field name="model_id" ref="model_pager_check"/>
            <field name="domain_force">['&amp;', '|', ('website_id', '=', False), ('website_id', '=', user.website_id.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_admin'))]"/>
        </record>

        <record id="pager_check_website_rule_svc" model="ir.rule">
            <field name="name">Pager Check Multi-Website Service</field>
            <field name="model_id" ref="model_pager_check"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_service'))]"/>
        </record>

        <record id="pager_incident_website_company_rule" model="ir.rule">
            <!-- See pager_check_website_company_rule above: two separate
                 same-group rules are OR'ed, not AND'ed, in Odoo. -->
            <field name="name">Pager Incident Multi-Website/Multi-Company</field>
            <field name="model_id" ref="model_pager_incident"/>
            <field name="domain_force">['&amp;', '|', ('website_id', '=', False), ('website_id', '=', user.website_id.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_admin'))]"/>
        </record>

        <record id="pager_incident_website_rule_svc" model="ir.rule">
            <field name="name">Pager Incident Multi-Website Service</field>
            <field name="model_id" ref="model_pager_incident"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_service')), (4, ref('pager_duty.group_pager_mcp_triage_service'))]"/>
        </record>

        <record id="pager_incident_website_rule_creator" model="ir.rule">
            <!-- Same unconditional scope group_pager_service gets on this one
                 model (report_incident() is called with an explicit website_id
                 from any tenant's daemon, so a per-company rule would silently
                 drop cross-tenant reports), on ONLY this model, no pager.check
                 or pager.log.* rules for this group, deliberately. -->
            <field name="name">Pager Incident Creator Service</field>
            <field name="model_id" ref="model_pager_incident"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_incident_creator'))]"/>
        </record>

        <record id="pager_log_file_website_company_rule" model="ir.rule">
            <!-- See pager_check_website_company_rule above: two separate
                 same-group rules are OR'ed, not AND'ed, in Odoo. -->
            <field name="name">Pager Log File Multi-Website/Multi-Company</field>
            <field name="model_id" ref="model_pager_log_file"/>
            <field name="domain_force">['&amp;', '|', ('website_id', '=', False), ('website_id', '=', user.website_id.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_admin'))]"/>
        </record>

        <record id="pager_log_file_website_rule_svc" model="ir.rule">
            <field name="name">Pager Log File Multi-Website Service</field>
            <field name="model_id" ref="model_pager_log_file"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_service'))]"/>
        </record>

        <record id="pager_log_pattern_website_company_rule" model="ir.rule">
            <!-- See pager_check_website_company_rule above: two separate
                 same-group rules are OR'ed, not AND'ed, in Odoo. -->
            <field name="name">Pager Log Pattern Multi-Website/Multi-Company</field>
            <field name="model_id" ref="model_pager_log_pattern"/>
            <field name="domain_force">['&amp;', '|', ('website_id', '=', False), ('website_id', '=', user.website_id.id), '|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_admin'))]"/>
        </record>

        <record id="pager_log_pattern_website_rule_svc" model="ir.rule">
            <field name="name">Pager Log Pattern Multi-Website Service</field>
            <field name="model_id" ref="model_pager_log_pattern"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_service'))]"/>
        </record>

        <record id="pager_log_search_job_company_rule" model="ir.rule">
            <field name="name">Pager Log Search Job Multi-Company</field>
            <field name="model_id" ref="model_pager_log_search_job"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_admin'))]"/>
        </record>

        <record id="pager_log_search_job_company_rule_svc" model="ir.rule">
            <field name="name">Pager Log Search Job Multi-Company Service</field>
            <field name="model_id" ref="model_pager_log_search_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('pager_duty.group_pager_service'))]"/>
        </record>
    </data>
    <data>
        <record id="user_pager_service_internal" model="res.users">
            <field name="name">Pager Service Internal</field>
            <field name="login">pager_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('pager_duty.group_pager_service'), ref('base.group_user'), ref('website.group_multi_website')])]"/>
        </record>

        <record id="user_pager_incident_creator" model="res.users">
            <field name="name">Pager Incident Creator</field>
            <field name="login">pager_incident_creator</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <!-- group_pager_incident_creator, NOT group_pager_service, see that
                 group's own comment above. A (6, 0, ...) set, so an upgrade of an
                 existing database actively drops the old group_pager_service
                 membership rather than leaving it behind. -->
            <field name="group_ids" eval="[(6, 0, [ref('pager_duty.group_pager_incident_creator'), ref('base.group_user'), ref('website.group_multi_website')])]"/>
        </record>

        <record id="user_pager_mcp_triage_service" model="res.users">
            <field name="name">Pager Duty MCP Triage Service</field>
            <field name="login">pager_mcp_triage_service</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('pager_duty.group_pager_mcp_triage_service'), ref('base.group_user'), ref('website.group_multi_website')])]"/>
        </record>
    </data>
</odoo>
