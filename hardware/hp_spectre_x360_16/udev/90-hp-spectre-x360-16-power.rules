# SPDX-License-Identifier: GPL-3.0-or-later
# Set the HP platform profile when the charger is plugged or unplugged (see scripts/set-platform-profile).
ACTION=="change", SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ATTR{[dmi/id]product_name}=="HP Spectre x360 2-in-1 Laptop 16-f*", RUN+="/usr/lib/hp-spectre-x360-16-support/set-platform-profile"
