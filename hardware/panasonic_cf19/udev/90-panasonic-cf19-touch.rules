# SPDX-License-Identifier: GPL-3.0-or-later
#
# Panasonic Toughbook CF-19: Fujitsu USB touch panel (0430:0502, "USB Touch Panel").
# The panel is a single-touch, boot-mouse-class absolute pointer without touch
# capability or axis resolution, so libinput and GNOME treat it as a pointer and
# GNOME does not rotate its mapping with the display.  The relay service
# (panasonic-cf19-touch@.service) reads it, applies the calibration and presents a
# proper touchscreen device; libinput is told to ignore the physical panel.
#
# A finger lands about 22 px higher than the stylus on this resistive panel; the
# calibration (in cf19-touch-relay) is fitted to the stylus.
#
# Applied only when the DMI product name is a CF-19.
ACTION=="remove", GOTO="panasonic_cf19_touch_end"
SUBSYSTEM!="input", GOTO="panasonic_cf19_touch_end"
KERNEL!="event[0-9]*", GOTO="panasonic_cf19_touch_end"
ATTR{[dmi/id]product_name}!="CF-19*", GOTO="panasonic_cf19_touch_end"

ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="0430", ENV{ID_MODEL_ID}=="0502", ENV{LIBINPUT_IGNORE_DEVICE}="1", TAG+="systemd", ENV{SYSTEMD_WANTS}="panasonic-cf19-touch@%k.service"

LABEL="panasonic_cf19_touch_end"
