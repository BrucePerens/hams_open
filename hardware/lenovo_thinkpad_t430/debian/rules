#!/usr/bin/make -f
%:
	dh $@

P = debian/lenovo-thinkpad-t430-support/usr/share/lenovo-thinkpad-t430-support

override_dh_auto_install:
	install -D -m 0644 tlp.d/20-lenovo-thinkpad-t430.conf $(P)/20-lenovo-thinkpad-t430.conf
	install -D -m 0644 logind.d/50-lenovo-thinkpad-t430.conf $(P)/logind-50-lenovo-thinkpad-t430.conf
	install -D -m 0644 dconf.d/50-lenovo-thinkpad-t430 $(P)/dconf-50-lenovo-thinkpad-t430
	install -D -m 0644 NetworkManager/50-lenovo-thinkpad-t430.conf $(P)/nm-50-lenovo-thinkpad-t430.conf
