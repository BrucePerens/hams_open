#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

case "$1" in
    configure)
        if [ "$(cat /sys/class/dmi/id/product_version 2>/dev/null)" = "ThinkPad T430" ]; then
            S=/usr/share/lenovo-thinkpad-t430-support
            install -D -m 0644 $S/20-lenovo-thinkpad-t430.conf /etc/tlp.d/20-lenovo-thinkpad-t430.conf
            install -D -m 0644 $S/logind-50-lenovo-thinkpad-t430.conf /etc/systemd/logind.conf.d/50-lenovo-thinkpad-t430.conf
            install -D -m 0644 $S/dconf-50-lenovo-thinkpad-t430 /etc/dconf/db/local.d/50-lenovo-thinkpad-t430
            install -D -m 0644 $S/nm-50-lenovo-thinkpad-t430.conf /etc/NetworkManager/conf.d/50-lenovo-thinkpad-t430.conf
            if [ ! -e /etc/dconf/profile/user ]; then
                install -D -m 0644 /dev/null /etc/dconf/profile/user
                printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
            elif ! grep -q '^system-db:local' /etc/dconf/profile/user; then
                printf 'system-db:local\n' >> /etc/dconf/profile/user
            fi
            if command -v dconf >/dev/null 2>&1; then
                dconf update >/dev/null 2>&1 || true
            fi
            if [ -d /run/systemd/system ]; then
                systemctl reload NetworkManager >/dev/null 2>&1 || true
            fi
            if [ -d /run/systemd/system ] && command -v tlp >/dev/null 2>&1; then
                tlp start >/dev/null 2>&1 || true
            fi
            echo "lenovo-thinkpad-t430-support: the lid setting takes effect at the next boot." >&2
        fi
        ;;
esac
#DEBHELPER#
