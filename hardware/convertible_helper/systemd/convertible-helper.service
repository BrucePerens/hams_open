[Unit]
Description=Tablet-mode and tablet-button helper for convertible laptops
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/convertible-helper
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
