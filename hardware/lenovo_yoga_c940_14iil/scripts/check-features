#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Read-only feature check for the Lenovo Yoga C940-14IIL.  Run with sudo for the camera, microphone and fingerprint
# lines.  Makes no sound and changes nothing.  Prints one line per feature: OK, WARN or FAIL.
ok()   { printf 'OK    %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; }

grep -q '^Lenovo Yoga C940-14IIL' /sys/class/dmi/id/product_version 2>/dev/null || warn "not a Yoga C940-14IIL"

[ -d /sys/class/backlight/intel_backlight ] && ok "screen backlight" || fail "screen backlight"
[ -e /sys/class/leds/platform::kbd_backlight/brightness ] && ok "keyboard backlight" || fail "keyboard backlight"
grep -q 'Yoga Tablet Mode' /proc/bus/input/devices && ok "tablet-mode switch device" || fail "tablet-mode switch"
grep -q 'Wacom HID .* Pen' /proc/bus/input/devices && ok "pen digitizer" || fail "pen digitizer"
grep -q 'Wacom HID .* Finger' /proc/bus/input/devices && ok "touchscreen" || fail "touchscreen"
grep -q 'Touchpad' /proc/bus/input/devices && ok "touchpad" || fail "touchpad"
[ -d /sys/bus/iio/devices/iio:device0 ] && ok "accelerometer (ISH): $(cat /sys/bus/iio/devices/iio:device0/name)" || fail "accelerometer"
journalctl -k -b 2>/dev/null | grep -q 'iwlwifi.*loaded firmware version' && ok "Wi-Fi firmware loaded" || fail "Wi-Fi firmware"
journalctl -k -b 2>/dev/null | grep -q 'Bluetooth: hci0: Found device firmware' && ok "Bluetooth firmware loaded" || fail "Bluetooth firmware"
grep -q sof-hda-dsp /proc/asound/cards && ok "audio card sof-hda-dsp" || fail "audio card"
if [ "$(id -u)" = 0 ]; then
    if command -v arecord >/dev/null && arecord -D hw:0,6 -f S16_LE -r 48000 -c 2 -d 1 /dev/null >/dev/null 2>&1; then
        ok "microphone array (DMIC) opens"
    else
        fail "microphone array"
    fi
    [ -c /dev/video0 ] && ok "camera /dev/video0 ($(cat /sys/class/video4linux/video0/name))" || fail "camera"
else
    warn "run as root for the microphone check"
fi
lsusb -d 06cb:00be >/dev/null 2>&1 && warn "fingerprint reader 06cb:00be present; libfprint has no driver for it"
command -v fprintd-list >/dev/null && { fprintd-list "${SUDO_USER:-$USER}" 2>&1 | head -2 | tr '\n' ' '; echo; }
[ -e /sys/firmware/acpi/platform_profile ] && ok "platform profile: $(cat /sys/firmware/acpi/platform_profile)" || fail "platform profile"
[ -d /sys/class/power_supply/BAT1 ] && ok "battery: $(cat /sys/class/power_supply/BAT1/status) $(cat /sys/class/power_supply/BAT1/capacity)%"
