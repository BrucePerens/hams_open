<!--
Built 2026-08-29, not yet approved: see docs/proposals/ADVERTISING.md for the
open product/legal questions this doesn't resolve (revenue share, category
blocklist, notice/opt-out). Renders nothing at all until an administrator sets
BOTH website.google_adsense_client_id and website.google_adsense_footer_slot_id
in Website > Configuration > Settings: there is no default "on" state, and
this template must not be treated as launched just because it's installed.

Consent gating: this template establishes its own independent Google Consent
Mode default+update wiring (ad_storage/ad_user_data/ad_personalization denied
until the cookies bar's optionalCookiesAccepted event fires), mirroring core
website's own google_analytics_key handling in
odoo/addons/website/views/website_templates.xml exactly: confirmed by
reading that template directly, not assumed. This is deliberate, not
redundant with GA's own consent wiring: GA's tracking_code_config script only
exists when website.google_analytics_key is itself configured, and AdSense
must stay consent-gated regardless of whether GA happens to also be
configured on the same site.
-->
<odoo>
    <template id="layout_inherit_adsense" inherit_id="website.layout" name="AdSense Footer Placement">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_xpath_rendering_advertising] -->

        <!-- The AdSense loader plus its own independent Consent Mode wiring, -->
        <!-- covering both the "unconfigured" and "configured" cases below. -->
        <!-- [@ANCHOR: xpath_rendering_advertising_head] -->

        <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_advertising] -->
        <xpath expr="//head" position="inside">
            <t t-if="website.google_adsense_client_id and not editable">
                <script id="adsense_consent_config">
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('consent', 'default', {
                        'ad_storage': 'denied',
                        'ad_user_data': 'denied',
                        'ad_personalization': 'denied',
                        'analytics_storage': 'denied',
                    });
                    function adsenseConsentsGranted() {
                        gtag('consent', 'update', {
                            'ad_storage': 'granted',
                            'ad_user_data': 'granted',
                            'ad_personalization': 'granted',
                        });
                    }
                    <t t-if="website._allConsentsGranted()">
                        adsenseConsentsGranted();
                    </t>
                    <t t-else="">
                        document.addEventListener(
                            "optionalCookiesAccepted",
                            adsenseConsentsGranted,
                            {once: true}
                        );
                    </t>
                </script>
                <script
                    id="adsense_loader"
                    async="async"
                    crossorigin="anonymous"
                    t-attf-src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ website.google_adsense_client_id }}"
                />
            </t>
        </xpath>

        <!-- The footer banner placement, gated on both config fields being -->
        <!-- set. Per Bruce's own direct instruction, 2026-09-01 ("I think a -->
        <!-- sidebar and footer per page would be a good start. Can we also -->
        <!-- fit an ad in ham_shack?"), this renders on every page including -->
        <!-- /shack; the earlier /shack exclusion (a real-time operating -->
        <!-- console being a bad place for a slow-loading ad script) was a -->
        <!-- deliberate caution this proposal itself flagged as open, and -->
        <!-- Bruce has now overridden it directly, not something to -->
        <!-- second-guess. -->
        <!-- [@ANCHOR: xpath_rendering_advertising_footer] -->

        <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_advertising] -->
        <xpath expr="//footer" position="after">
            <t t-if="website.google_adsense_client_id and website.google_adsense_footer_slot_id and not editable">
                <!--
                    Single footer banner, matching this proposal's own
                    "least intrusive starting point" recommendation and
                    user_websites' existing layout_inherit_report_violation
                    precedent for placement style (//footer, position=after).
                -->
                <div class="container mt-3 mb-3 text-center" id="advertising_footer_slot">
                    <ins class="adsbygoogle"
                         style="display:block"
                         t-att-data-ad-client="website.google_adsense_client_id"
                         t-att-data-ad-slot="website.google_adsense_footer_slot_id"
                         data-ad-format="auto"
                         data-full-width-responsive="true"/>
                    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </div>
            </t>

            <!--
                Fixed-position sidebar ("skyscraper") placement, per Bruce's
                same 2026-09-01 instruction. Deliberately CSS-fixed rather
                than injected into a page-specific sidebar region: website.
                layout has no generic sidebar slot common to every page type
                (some pages, like blog/forum, have their own; most, like
                /shack, don't); a fixed-position unit works identically on
                every page without needing per-page-type placement logic.
                Hidden below the Bootstrap xl breakpoint (d-none d-xl-block)
                so it never competes with content or controls on narrower
                viewports, including /shack's own multi-column console
                layout at typical laptop widths.
            -->
            <!-- [@ANCHOR: xpath_rendering_advertising_sidebar] -->

            <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_advertising] -->
            <t t-if="website.google_adsense_client_id and website.google_adsense_sidebar_slot_id and not editable">
                <div class="d-none d-xl-block" id="advertising_sidebar_slot"
                     style="position:fixed; right:8px; top:120px; width:160px; z-index:1020;">
                    <ins class="adsbygoogle"
                         style="display:inline-block;width:160px;height:600px"
                         t-att-data-ad-client="website.google_adsense_client_id"
                         t-att-data-ad-slot="website.google_adsense_sidebar_slot_id"/>
                    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
