# Claude Code agent worktrees -- created locally per-session for isolated
# subagent dispatches (Agent tool, isolation: "worktree"), never meant to be
# committed; a stray one otherwise shows up as untracked noise in every
# `git status` for the rest of the session.
.claude/worktrees/

# Internationalization
i18n/hams_master.pot

# Python / Bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/

# Environment Variables / Secrets
.env

# IDEs / Editors
.vscode/
.idea/

# OS Generated
.DS_Store
Thumbs.db

# Odoo Local Dev
*.log
filestore/
sessions/

# Custom Tooling Workspaces
task_workspace_*/
*.patch
*.bak
*.tmp

# Stage 2 coverage instrumentation output (ADR 0090 / ANCHOR_COVERAGE_AND_REMEDIATION_PLAN.md)
coverage_report/

# Bug-hunt finding (pager_duty models/pager_check.py's _get_config_path claim, 2026-09-09):
# this is action_push_to_json()'s dev-environment fallback output path, used when
# /opt/hams/etc isn't writable. It can carry plaintext dbpass/SMTP credentials for
# every monitored check -- it must never be a git-tracked file in this PUBLIC repo.
# A generated copy with no real secrets was already committed before this rule existed
# (see git history); untracking it going forward here, not rewriting past history.
pager_duty/daemon/pager_config.json
