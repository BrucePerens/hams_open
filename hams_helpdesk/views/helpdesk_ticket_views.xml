<odoo>
    <record id="view_hams_helpdesk_ticket_form" model="ir.ui.view">
        <!-- [@ANCHOR: COMM_helpdesk_ticket_form] -->
        <field name="name">hams_helpdesk.ticket.form</field>
        <field name="model">hams_helpdesk.ticket</field>
        <!-- audit-ignore-view: Tested by [@ANCHOR: COMM_helpdesk_operator_tour] -->
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <!-- action_close()'s own anchor comment (models/helpdesk_ticket.py)
                         explains why this button exists alongside the already-clickable
                         stage statusbar a few lines below: a real admin reached for unlink()
                         instead because there was no button-shaped way to just close a
                         ticket. -->
                    <button name="action_close" string="Close Ticket" type="object" invisible="not id or stage == 'closed'"/>
                    <button name="action_shift_handoff" string="Shift Handoff" type="object" class="oe_highlight" invisible="not id or stage in ('resolved', 'closed')"/>
                    <!-- [@ANCHOR: hams_helpdesk:COMM_ncmec_report_buttons] -->
                    <!-- No dedicated UI tour for these three admin-only buttons (burn-ignore-tour
                         would apply if this were a standalone record; this one is already covered
                         by the form view's own audit-ignore-view/COMM_helpdesk_operator_tour tag
                         above). Their server-side guards (group, ticket_type, report state) are
                         the real enforcement and are unit-tested directly, not just hidden by
                         invisible=, see hams_helpdesk/tests/test_ncmec_report.py's own
                         test_action_ncmec_report_requires_group_system,
                         test_action_ncmec_report_refuses_a_non_csam_ticket,
                         test_action_apply_legal_hold_manually_requires_group_system, and
                         test_action_mark_report_filed_manually_requires_group_system. -->
                    <button name="action_ncmec_apply_legal_hold_manually" string="Apply Legal Hold Manually" type="object"
                            groups="base.group_system"
                            invisible="ticket_type != 'csam_enticement_trafficking' or ncmec_legal_hold_applied"/>
                    <button name="action_ncmec_report" string="Report to NCMEC" type="object" class="btn-danger"
                            groups="base.group_system"
                            confirm="This files a mandatory federal report with NCMEC's CyberTipline (or opens the manual-portal fallback if no API credentials are configured). Continue?"
                            invisible="ticket_type != 'csam_enticement_trafficking' or ncmec_report_state != 'not_reported'"/>
                    <button name="action_ncmec_mark_report_filed_manually" string="Mark Filed Manually" type="object"
                            groups="base.group_system"
                            confirm="Only use this after you have actually pasted the report packet into NCMEC's own reporting portal. Continue?"
                            invisible="ticket_type != 'csam_enticement_trafficking' or ncmec_report_state != 'not_reported'"/>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                    <field name="ncmec_report_state" widget="statusbar"
                           invisible="ticket_type != 'csam_enticement_trafficking'"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <!-- Untrusted-text filter banner. The text shown below is the filtered version; the
                         original as received is on the Filter Findings page. -->
                    <div class="alert alert-danger" role="alert" invisible="not suspicious">
                        <strong>Suspicious ticket:</strong> hidden or injected content was found
                        (score <field name="suspicion_score" class="oe_inline"/>). It is not shown to any AI
                        and is never auto-triaged or auto-answered. See the Filter Findings page.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="suspicious or not suspicion_removed">
                        <field name="suspicion_removed" class="oe_inline"/> hidden characters were removed from
                        this ticket. See the Filter Findings page.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="callsign"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="calendar_event_id"/>
                            <field name="website_id" groups="base.group_no_one"/>
                            <field name="company_id" invisible="1"/>
                            <field name="ticket_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Filter Findings" groups="hams_helpdesk.group_helpdesk_user"
                              invisible="not suspicion_removed and not suspicion_score and not suspicion_log_ids">
                            <field name="suspicion_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="source"/>
                                    <field name="score"/>
                                    <field name="removed"/>
                                    <field name="findings_summary"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="source"/>
                                        <field name="score"/>
                                        <field name="removed"/>
                                        <field name="findings_json" widget="text"/>
                                        <field name="raw_original" widget="text"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <!-- [@ANCHOR: hams_helpdesk:COMM_ncmec_report_page]
                             Field-level visibility only, same reasoning as the header buttons
                             above: the fields shown here carry no write access of their own
                             beyond what write()'s own restricted_fields set already blocks for a
                             portal user (see models/helpdesk_ticket.py). -->
                        <page string="NCMEC Report" invisible="ticket_type != 'csam_enticement_trafficking'"
                              groups="base.group_system">
                            <group>
                                <group>
                                    <separator string="Legal Hold"/>
                                    <field name="ncmec_recording_uuid"/>
                                    <field name="ncmec_recording_playback_url" widget="url"/>
                                    <field name="ncmec_reported_user_id"/>
                                    <field name="ncmec_legal_hold_applied"/>
                                    <field name="ncmec_legal_hold_note" invisible="ncmec_legal_hold_applied"/>
                                </group>
                                <group>
                                    <separator string="Report Status"/>
                                    <field name="ncmec_report_state"/>
                                    <field name="ncmec_report_reference"/>
                                    <field name="ncmec_report_submitted_at"/>
                                    <field name="ncmec_report_submitted_by_id"/>
                                    <field name="ncmec_contact_email"/>
                                    <field name="ncmec_contact_phone"/>
                                </group>
                            </group>
                            <group>
                                <separator string="Report Packet (copy into NCMEC's portal if no API credentials are configured)"/>
                                <field name="ncmec_report_packet" nolabel="1" widget="text" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hams_helpdesk_ticket_list" model="ir.ui.view">
        <!-- [@ANCHOR: COMM_helpdesk_ticket_list] -->
        <field name="name">hams_helpdesk.ticket.list</field>
        <!-- audit-ignore-view: Tested by [@ANCHOR: COMM_helpdesk_operator_tour] -->
        <field name="model">hams_helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Helpdesk Tickets">
                <field name="name"/>
                <field name="callsign"/>
                <field name="user_id"/>
                <field name="stage"/>
                <field name="priority" widget="priority"/>
                <field name="suspicious" optional="show" decoration-danger="suspicious"/>
            </list>
        </field>
    </record>

    <record id="action_hams_helpdesk_ticket" model="ir.actions.act_window">
        <!-- burn-ignore-tour -->
        <field name="name">Helpdesk Tickets</field>
        <field name="res_model">hams_helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Dedicated review queue for the "spam" stage above: without this,
         a human reviewing for false positives would have to know to filter
         the main Tickets list manually. Still just the same model/views,
         scoped by domain only; nothing about this action makes a
         quarantined ticket harder to recover. -->
    <record id="action_hams_helpdesk_ticket_spam_review" model="ir.actions.act_window">
        <!-- burn-ignore-tour -->
        <field name="name">Spam / Phishing Review Queue</field>
        <field name="res_model">hams_helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('stage', '=', 'spam')]</field>
    </record>

    <menuitem id="menu_hams_helpdesk_root" name="Helpdesk" sequence="50"/>
    <menuitem id="menu_hams_helpdesk_tickets" name="Tickets" parent="menu_hams_helpdesk_root" action="action_hams_helpdesk_ticket" sequence="10"/>
    <menuitem id="menu_hams_helpdesk_tickets_spam_review" name="Spam / Phishing Review" parent="menu_hams_helpdesk_root" action="action_hams_helpdesk_ticket_spam_review" sequence="20"/>
</odoo>
