<odoo>
    <data noupdate="1">
        <record id="group_mail_ingest_service" model="res.groups">
            <field name="name">Inbound Mail Ingest Service</field>
            <field name="comment">Internal system group for the SES-to-S3-to-Odoo inbound mail polling daemon. See docs/proposals/EMAIL_SEND_RECEIVE.md.</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="user_mail_ingest_service" model="res.users">
            <field name="name">Inbound Mail Ingest Service</field>
            <field name="login">mail_ingest_service_internal</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_mail_ingest_service')])]"/>
        </record>
    </data>
</odoo>
