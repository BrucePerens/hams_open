<odoo>
    <data noupdate="1">
        <record id="group_edge_routing_service_account" model="res.groups">
            <field name="name">Service Account: Edge Routing</field>
        </record>
    </data>
    <data>
        <record id="edge_routing_service_account" model="res.users">
            <field name="name">Edge Routing Daemon</field>
            <field name="login">edge_routing_daemon</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('edge_routing.group_edge_routing_service_account')])]"/>
        </record>
    </data>
    <data noupdate="1">
        <!-- audit-ignore-cron: push_all_to_pager_duty() can't be split
             into per-batch _trigger() re-runs; it must build the FULL
             current domain routing table before POSTing once, since a
             partial push would send PagerDuty an actively wrong
             (incomplete) domain list, not a safe partial update. It
             already paginates its own internal domain queries in
             bounded 1000-row batches rather than loading everything in
             one query, and _invalidate_cache() already debounces
             repeated triggers via this same cron's own _trigger(). -->
        <record id="ir_cron_push_pager_duty" model="ir.cron">
            <field name="name">Edge Routing: Sync domains to PagerDuty</field>
            <field name="model_id" ref="model_edge_routing_domain"/>
            <field name="user_id" ref="edge_routing.edge_routing_service_account"/>
            <field name="state">code</field>
            <field name="code">model.push_all_to_pager_duty()</field> 
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
