# hams-node BIRD 2 settings: the node's sessions to the hams.com route servers (multi-hop). Off by default.
config bird 'main'
	option enabled '0'
	# AS number, the /40 supernet, this node's /60 and router-id serial from the hams.com router configuration page
	option asn ''
	option prefix ''
	option prefix60 ''
	option serial ''
	# set to 1 only while the node has a live RF link: its routes are then tagged with the RF community
	option rf_live '0'
	# route server addresses
	# list server '2001:db8::1'
	# direct RF neighbours, "ASN,ADDRESS,INTERFACE,PREFIX60[,SIIT96]": BGP over the radio link, no route server or internet needed. Each
	# session is authenticated with IPsec AH (integrity only, nothing encrypted: Part 97; the kernel has no TCP-MD5) using a key derived from
	# rf_secret_dir/ASN.secret (root-only, from enrolment); the address must be link-local;
	# the neighbour may announce only its own /60 (and SIIT /96); their routes win over the route servers'.
	# option rf_secret_dir '/etc/hams-node/rf.d'
	# list neighbor '4200000007,fe80::7,rf0,2001:db8:ab00:70::/60'
