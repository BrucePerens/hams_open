# hams-node: browser side of the ham-legal SSL proxy (per-node CA and PAC file).
config proxyca 'main'
	# the LAN listener (ham_proxy --lan) is off until enabled; `proxy` below must then be this node's private LAN address (never a wildcard)
	option enabled '0'
	# where the browsers on the LAN reach the proxy (the router's LAN address and the ham_proxy port)
	option proxy '192.168.1.1:8443'
	# one domain per line, `example.org` or `*.example.org` (same file format as the ham_proxy whitelist)
	option whitelist '/etc/hams-node/whitelist'
	# the ham network's address block: its hosts go through the proxy, and the CA may name them
	# option net_prefix '2001:db8:ab00:'
	# option net_cidr '2001:db8:ab00::/40'
	# the operator's callsign, written to the station-ID log with every flow (Part 97); required to enable
	option callsign ''
	# the Hams.com Net resolver (ip:port, UDP) for the TLSA records of .ham servers; required to enable
	option resolver ''
	# optional: where .ham names are looked up (AAAA), as for hams-node-web
	# option ham_resolver ''
	# the site gateway for whitelisted Internet sites (host:port, integrity-only TLS) and the CA file that signs its certificate; required to enable
	option gateway ''
	option gateway_ca ''
	option log '/var/log/hams-node-proxyca/stationid.log'
	# optional Ed25519 key: HTML gets the signed integrity indicator
	# option sign_key ''
