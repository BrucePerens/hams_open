#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Runs the Hams.com Net web gateway (ham_proxy --gateway) for IPv4 clients on an AREDN mesh, and makes the node's dnsmasq answer .ham A queries
# with the gateway's address. Does nothing until /etc/config/hams_node_web is enabled and complete (see hams-node-web).
START=97
USE_PROCD=1
INITD=${HAMS_NODE_INITD:-/etc/init.d}
DNS=${HAMS_NODE_WEB_DNS:-/tmp/dnsmasq.d/hams-web.conf}

start_service() {
	local args
	args=$(hams-node-web args) || return 1
	[ -n "$args" ] || return 0
	mkdir -p "$(dirname "$(uci -q get hams_node_web.main.log)")"
	hams-node-web dns "$DNS" || return 1
	[ -x "$INITD/dnsmasq" ] && "$INITD/dnsmasq" restart
	set -- $args
	procd_open_instance
	procd_set_param command /usr/sbin/ham_proxy "$@"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$DNS"
	[ -x "$INITD/dnsmasq" ] && "$INITD/dnsmasq" restart
	return 0
}

service_triggers() {
	procd_add_reload_trigger hams_node_web
}
