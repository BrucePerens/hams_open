#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Renders the dnsmasq snippet for .ham and the member reverse zone (uci hams_node_dns) and restarts dnsmasq (a reload does not re-read its conf-dir). Stop removes it.
START=96
USE_PROCD=1
INITD=${HAMS_NODE_INITD:-/etc/init.d}
OUT=${HAMS_NODE_DNS_OUT:-/tmp/dnsmasq.d/hams-ham.conf}

reload_dnsmasq() {
	[ -x "$INITD/dnsmasq" ] && "$INITD/dnsmasq" restart
	return 0
}

# OpenWrt's dnsmasq reads extra files only from the directory in dhcp.@dnsmasq[0].confdir (its instance directory otherwise); set it when
# unset, and write the snippet into whatever directory is set.
ensure_confdir() {
	local dir
	dir=$(uci -q get 'dhcp.@dnsmasq[0].confdir')
	if [ -z "$dir" ]; then
		dir=$(dirname "$OUT")
		uci -q get 'dhcp.@dnsmasq[0]' >/dev/null || return 0
		uci set "dhcp.@dnsmasq[0].confdir=$dir" && uci commit dhcp
	fi
	OUT=$dir/$(basename "$OUT")
	# dnsmasq's rebind protection drops private answers (AREDN's 10.x hosts); .ham names are exempt
	uci -q get 'dhcp.@dnsmasq[0].rebind_domain' | grep -qw ham || {
		uci add_list 'dhcp.@dnsmasq[0].rebind_domain=ham' && uci commit dhcp
	}
}

# AAAA for IPv6 clients: AREDN's dnsmasq (also one of our own, same binary) answers every forwarded AAAA query with NODATA, so IPv6 clients cannot
# get .ham AAAA through it. With v6_addr set, port 53 of that one extra address (added to v6_iface, default br-lan) is sent by nft straight to the
# first IPv6 resolver of the list: no process runs and AREDN's dnsmasq is untouched (the DNAT happens before local delivery, so its own socket on
# that address never sees the queries). Point the IPv6 clients at v6_addr (router advertisement or DHCPv6 of the router that sends them; AREDN's
# dnsmasq has no DHCPv6/RA).
start_v6() {
	local addr iface r res port
	addr=$(uci -q get hams_node_dns.main.v6_addr)
	[ -n "$addr" ] || return 0
	iface=$(uci -q get hams_node_dns.main.v6_iface); [ -n "$iface" ] || iface=br-lan
	for r in $(uci -q get hams_node_dns.main.resolver); do
		case $r in *:*) res=${r%%#*}; port=53; case $r in *#*) port=${r#*#} ;; esac; break ;; esac
	done
	case $addr in *[!A-Fa-f0-9:]*) echo "hams-node-dns: bad v6_addr" >&2; return 1 ;; esac
	[ -n "$res" ] || { echo "hams-node-dns: v6_addr needs an IPv6 resolver" >&2; return 1; }
	ip -6 addr add "$addr/128" dev "$iface" 2>/dev/null
	nft -f - <<EOF
table inet hams_dns6 {
	chain pre {
		type nat hook prerouting priority dstnat; policy accept;
		ip6 daddr $addr meta l4proto { udp, tcp } th dport 53 dnat ip6 to [$res]:$port
	}
	chain post {
		type nat hook postrouting priority srcnat; policy accept;
		ip6 daddr $res meta l4proto { udp, tcp } th dport $port ct status dnat masquerade
	}
}
EOF
}

stop_v6() {
	nft delete table inet hams_dns6 2>/dev/null
}

start_service() {
	ensure_confdir
	rm -f "$OUT"
	stop_v6
	hams-node-dns render "$OUT" || return 1
	reload_dnsmasq
	start_v6
}

stop_service() {
	rm -f "$OUT"
	stop_v6
	reload_dnsmasq
}

service_triggers() {
	procd_add_reload_trigger hams_node_dns
}
