#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Answers neighbouring routers that ask for the signed deprecation list (tcp 5710, see hams-node-status gossip).
USE_PROCD=1
START=97

start_service() {
	[ -s /etc/hams-node/deprecation.pub ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/hams-node-status listen
	procd_set_param respawn
	procd_close_instance
}
