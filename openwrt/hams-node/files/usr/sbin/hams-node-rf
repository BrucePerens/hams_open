#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# hams-node-rf scan | list
# Finds the node's radio interfaces and its AREDN neighbours; nothing else needs configuring.
# An interface is RF if the member listed it ("uci add_list hams_node_fw.main.rf_iface=IF", the one setting) or if `iw dev` reports it as a
# mesh point or IBSS (the AREDN modes) or if links.yaml (the router configuration download, /etc/hams-node/links.yaml) declares it type rf. Each RF interface goes into firewall zone hamrf (hams-node-fw ensure -r), so hams-node-wg refuses
# WireGuard on it and no encrypted-service port opens toward it (Part 97: no encryption over RF). While at least one RF interface is up,
# hams_node_bird.main.rf_live is 1 (the node's routes carry the RF community), the station ID reminder is written to
# $STATE/station_id_reminder (and the system log), and the AREDN neighbours seen on those interfaces (IPv6 neighbour table, link-local,
# reachable) are listed in $STATE/rf_neighbours as "INTERFACE ADDRESS". /etc/hams-node/gossip_neighbours is not touched here (hams-node-bird writes the BGP-session RF neighbours there).
# `list` prints the neighbours file. Exit 0 when the scan ran.
set -u
STATE=${HAMS_NODE_RF_STATE:-/var/run/hams-node}
OWNER=${HAMS_NODE_OWNER:-/etc/hams-node/owner}
LINKS=${HAMS_NODE_LINKS:-/etc/hams-node/links.yaml}
case ${1:-} in scan | list) ;; *) echo "usage: hams-node-rf scan | list" >&2; exit 2 ;; esac
[ "$1" = list ] && { cat "$STATE/rf_neighbours" 2>/dev/null; exit 0; }
mkdir -p "$STATE" || exit 1

up() { ip -o link show dev "$1" 2>/dev/null | grep -q '<[^>]*UP'; }
ifaces=$(uci -q get hams_node_fw.main.rf_iface 2>/dev/null)
for i in $(iw dev 2>/dev/null | awk '$1 == "Interface" { n = $2 } $1 == "type" && ($2 == "mesh" || $2 == "IBSS") { print n }'); do
	case " $ifaces " in *" $i "*) ;; *) ifaces="$ifaces $i" ;; esac
done
# links the member's router configuration (links.yaml from the portal download) declares as type rf
if [ -r "$LINKS" ]; then
	for i in $(awk '$1 == "-" && $2 == "name:" { n = $3 } $1 == "type:" && $2 == "rf" { print n }' "$LINKS"); do
		case " $ifaces " in *" $i "*) ;; *) ifaces="$ifaces $i" ;; esac
	done
fi

live=0 nb=
for i in $ifaces; do
	case $i in '' | *[!A-Za-z0-9_-]*) continue ;; esac
	hams-node-fw ensure -r "$i" || echo "hams-node-rf: could not put $i in the rf zone" >&2
	up "$i" || continue
	live=1
	nb="$nb$(ip -6 neigh show dev "$i" 2>/dev/null | awk -v i="$i" '$1 ~ /^fe80:/ && $NF != "FAILED" && $NF != "INCOMPLETE" { print i, $1 }')
"
done
printf '%s' "$nb" | sed '/^$/d' | sort -u > "$STATE/rf_neighbours"

if [ "$(uci -q get hams_node_bird.main.rf_live 2>/dev/null)" != "$live" ]; then
	uci set "hams_node_bird.main.rf_live=$live" && uci commit hams_node_bird
fi
if [ $live = 1 ]; then
	call=$(head -n 1 "$OWNER" 2>/dev/null)
	msg="Part 97: RF is enabled. Identify with your callsign${call:+ ($call)} at least every 10 minutes and at the end of a communication; no encryption over RF."
	if [ ! -f "$STATE/station_id_reminder" ]; then logger -t hams-node-rf "$msg" 2>/dev/null; fi
	echo "$msg" > "$STATE/station_id_reminder"
else
	rm -f "$STATE/station_id_reminder"
fi
exit 0
