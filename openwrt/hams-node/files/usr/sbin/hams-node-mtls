#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# hams-node-mtls: the router's web management (LuCI, ubus over HTTP, so rpcd and the hams-node APIs) is reachable only with a
# hams.com member (client) certificate that chains to the pinned member CA AND carries the enrolled owner's callsign (checked by the verify CGI, with a 30 day grace on the dates).
# nginx terminates TLS on :443 and asks for the certificate; uhttpd is moved to 127.0.0.1:8080 behind it.
#   hams-node-mtls [-s STATE_DIR] [-u BASE_URL] apply   (re)render the nginx config from the owner file; does nothing when not enrolled
#   hams-node-mtls [-s STATE_DIR] [-u BASE_URL] crl     fetch the identity CRL, verify it against the pinned CAs, keep the last good one
#   hams-node-mtls [-s STATE_DIR] lock                  turn the router password login off (run by the sso handler after the first verified owner)
#   hams-node-mtls [-s STATE_DIR] off                   stop and put uhttpd and rpcd back as they were (unenrol or recovery)
# Single sign-on: nginx has verified the owner certificate, so /hams-sso (a loopback-only CGI on uhttpd :8081, reachable only through
# nginx) opens a LuCI/rpcd session for the internal rpcd login "hams-owner" (random secret in mtls/sso.secret) and sets the LuCI cookie.
# LuCI's own 403 login page is redirected there, so the owner never types a password. After the first successful sign-in the stock
# rpcd logins (root and others) are removed, so no password works any more; `off` restores them.
# STATE_DIR (default /etc/hams-node) holds: owner (callsign, written by hams-node-enroll), member-ca.pem (the pinned CAs: Root A,
# Root B, Identity Root, Identity Issuing CA), member-crls.pem (the shipped CA-level CRLs), mtls/ (everything this script makes).
# Recovery if the owner certificate is lost: physical reset (firstboot), then enrol again.
set -u
state=/etc/hams-node base=''
while getopts s:u: opt; do
	case $opt in
	s) state=$OPTARG ;; u) base=$OPTARG ;;
	*) exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || { echo "usage: hams-node-mtls [-s DIR] [-u URL] apply | crl | lock | off" >&2; exit 2; }
[ -n "$base" ] || base=$(uci -q get hams_node_enroll.main.url 2>/dev/null)
[ -n "$base" ] || base=https://hams.com
umask 077
dir=$state/mtls
conf=$dir/nginx.conf
ca=$state/member-ca.pem
inner=127.0.0.1:8080
sso=127.0.0.1:8081
cron=${HAMS_NODE_CRON:-/etc/crontabs/root}
job="/usr/sbin/hams-node-mtls crl"

# crl_fresh FILE: its nextUpdate has not passed (openssl crl has no -checkend)
crl_fresh() {
	nu=$(openssl crl -in "$1" -noout -nextupdate -dateopt iso_8601 2>/dev/null | cut -d= -f2)
	nu=${nu%Z}
	[ -n "$nu" ] && [ "$(date -u -d "$nu" +%s 2>/dev/null || echo 0)" -gt "$(date -u +%s)" ]
}

reload_nginx() { [ -x /etc/init.d/hams-node-mtls ] && { /etc/init.d/hams-node-mtls enable; /etc/init.d/hams-node-mtls restart; }; return 0; }

do_crl() {
	mkdir -p "$dir" || exit 1
	uclient-fetch -q -O "$dir/identity.crl.new" "$base/identity-ca/crl" || { echo "hams-node-mtls: CRL not reachable; keeping the last one" >&2; exit 4; }
	# hams.com serves the CRL as DER; keep it as PEM for nginx
	f=$dir/identity.crl.new
	openssl crl -inform DER -in "$f" -outform PEM -out "$f.pem" 2>/dev/null || cp "$f" "$f.pem"
	rm -f "$f"
	if openssl crl -in "$f.pem" -CAfile "$ca" -noout 2>/dev/null && crl_fresh "$f.pem"; then
		mv "$f.pem" "$dir/identity.crl"
	else
		rm -f "$f.pem"
		echo "hams-node-mtls: fetched CRL is unsigned by the pinned CA or expired; keeping the last one" >&2
		exit 1
	fi
	do_apply
}

do_apply() {
	owner=$(cat "$state/owner" 2>/dev/null)
	[ -n "$owner" ] || { echo "hams-node-mtls: not enrolled (no owner); stock login unchanged" >&2; return 0; }
	case $owner in *[!A-Z0-9/]*) echo "hams-node-mtls: bad owner callsign" >&2; exit 1 ;; esac
	[ -s "$ca" ] || { echo "hams-node-mtls: no member CA file $ca" >&2; exit 1; }
	mkdir -p "$dir" || exit 1
	if [ ! -s "$dir/server.key" ]; then
		openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 -subj "/CN=hams-node" \
			-keyout "$dir/server.key" -out "$dir/server.crt" 2>/dev/null || exit 1
	fi
	# revocation: the CA-level CRLs shipped with the package plus the identity CRL; the verifier uses them only while the identity CRL is
	# fresh (an offline node must not lock its owner out; the CRL is refreshed from cron). The deprecation list is read by the verifier.
	cat "$state/member-crls.pem" "$dir/identity.crl" > "$dir/crls.pem" 2>/dev/null
	cat > "$conf" <<N
# made by hams-node-mtls; do not edit
worker_processes 1;
pid /var/run/hams-node-mtls.pid;
error_log syslog:server=unix:/dev/log warn;
events { worker_connections 64; }
http {
	access_log off;
	server {
		listen 443 ssl;
		listen [::]:443 ssl;
		ssl_certificate $dir/server.crt;
		ssl_certificate_key $dir/server.key;
		ssl_protocols TLSv1.2 TLSv1.3;
		ssl_client_certificate $ca;
		# nginx only asks for the certificate; /hams-verify (a loopback CGI) is the whole check: chain to the member CA, the enrolled
		# owner, the deprecation list, and a 30 day grace on the dates so a wrong clock or an outage cannot lock the owner out
		ssl_verify_client optional_no_ca;
		auth_request /hams-verify;
		location = /hams-verify {
			internal;
			auth_request off;
			proxy_pass http://$sso/cgi-bin/verify;
			proxy_pass_request_body off;
			proxy_set_header Content-Length "";
			proxy_set_header X-Client-Cert \$ssl_client_escaped_cert;
		}
		location = /hams-sso {
			proxy_pass http://$sso/cgi-bin/sso;
		}
		location @sso { return 302 /hams-sso; }
		location / {
			# no or an expired LuCI session shows LuCI's 403 login page: sign the verified owner in instead
			proxy_intercept_errors on;
			error_page 403 = @sso;
			proxy_pass http://$inner;
			proxy_set_header Host \$host;
			proxy_set_header X-Forwarded-Proto https;
		}
	}
}
N
	# single sign-on login for rpcd (the stock logins are kept until the first owner sign-in, see do_lock)
	[ -f "$dir/rpcd.orig" ] || uci -q export rpcd > "$dir/rpcd.orig"
	[ -s "$dir/sso.secret" ] || openssl rand -hex 24 > "$dir/sso.secret"
	uci -q delete rpcd.hamsowner
	uci set rpcd.hamsowner=login
	uci set rpcd.hamsowner.username=hams-owner
	uci set rpcd.hamsowner.password="$(openssl passwd -1 "$(cat "$dir/sso.secret")")"
	uci add_list rpcd.hamsowner.read='*'
	uci add_list rpcd.hamsowner.write='*'
	uci commit rpcd
	uci -q delete uhttpd.hamssso
	uci set uhttpd.hamssso=uhttpd
	uci add_list uhttpd.hamssso.listen_http="$sso"
	uci set uhttpd.hamssso.home=/usr/lib/hams-node/sso
	uci set uhttpd.hamssso.cgi_prefix=/cgi-bin
	[ ! -f "$dir/seen" ] || do_lock
	# uhttpd (LuCI, /ubus) only on loopback behind nginx; remember what it was
	if [ ! -f "$dir/uhttpd.orig" ]; then
		{ uci -q get uhttpd.main.listen_http; echo "--"; uci -q get uhttpd.main.listen_https; } > "$dir/uhttpd.orig"
	fi
	uci -q delete uhttpd.main.listen_http
	uci -q delete uhttpd.main.listen_https
	uci add_list uhttpd.main.listen_http="$inner"
	uci commit uhttpd
	[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart
	grep -qF "$job" "$cron" 2>/dev/null || echo "23 */6 * * * $job" >> "$cron"
	reload_nginx
	echo "hams-node-mtls: management now needs the certificate of $owner" >&2
}

do_lock() {
	for s in $(uci -q show rpcd | sed -n 's/^rpcd\.\([^.=]*\)=login$/\1/p'); do
		[ "$s" = hamsowner ] || uci delete "rpcd.$s"
	done
	uci commit rpcd
	: > "$dir/seen"
}

do_off() {
	[ -f "$dir/uhttpd.orig" ] || { rm -rf "$dir"; return 0; }
	[ -x /etc/init.d/hams-node-mtls ] && { /etc/init.d/hams-node-mtls stop; /etc/init.d/hams-node-mtls disable; }
	uci -q delete uhttpd.hamssso
	if [ -f "$dir/rpcd.orig" ]; then uci import rpcd < "$dir/rpcd.orig"; else uci -q delete rpcd.hamsowner; fi
	uci commit rpcd
	uci -q delete uhttpd.main.listen_http
	uci -q delete uhttpd.main.listen_https
	sed -n '1,/^--$/p' "$dir/uhttpd.orig" | grep -v '^--$' | while read -r a; do uci add_list uhttpd.main.listen_http="$a"; done
	sed -n '/^--$/,$p' "$dir/uhttpd.orig" | grep -v '^--$' | while read -r a; do uci add_list uhttpd.main.listen_https="$a"; done
	uci commit uhttpd
	[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart
	[ -f "$cron" ] && { grep -vF "$job" "$cron" > "$cron.new"; mv "$cron.new" "$cron"; }
	rm -rf "$dir"
}

case $1 in
apply) do_apply ;;
crl) do_crl ;;
lock) do_lock ;;
off) do_off ;;
*) exit 2 ;;
esac
