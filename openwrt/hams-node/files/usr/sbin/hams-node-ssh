#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# hams-node-ssh: once the node is enrolled and the owner has put a public key on it, SSH accepts keys only (dropbear PasswordAuth and
# RootPasswordAuth off). The key is added in LuCI (System > Administration > SSH-Keys), which is itself reachable only with the owner's
# member certificate (hams-node-mtls). With no key installed nothing changes, so the owner is never locked out.
# The owner's exported member-certificate keys (ECDSA P-256, one "SERIAL KEYLINE" per line in STATE_DIR/ssh_keys, written by hams-node-enroll from the
# signed router configuration) are kept in a marked block of the authorized keys, so `ssh -i hams-member-certificate.pem root@router` works with dropbear.
# A certificate named on the signed deprecation list (a "cert:ISSUER:SERIAL" line in STATE_DIR/deprecation_list) is left out of the block.
#   hams-node-ssh [-s STATE_DIR] [-k AUTHORIZED_KEYS] apply   key-only when enrolled and a key exists; else leave as is
#   hams-node-ssh [-s STATE_DIR] off                          restore the saved dropbear password settings (unenrol or recovery)
# Recovery: physical reset (firstboot) restores password login; enrol again.
set -u
state=/etc/hams-node keys=/etc/dropbear/authorized_keys
while getopts s:k: opt; do
	case $opt in
	s) state=$OPTARG ;; k) keys=$OPTARG ;;
	*) exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || { echo "usage: hams-node-ssh [-s DIR] [-k KEYS] apply | off" >&2; exit 2; }
orig=$state/ssh.orig sshkeys=$state/ssh_keys deplist=${HAMS_NODE_DEPRECATION_LIST:-$state/deprecation_list}
begin='# hams-node begin member certificate keys' end='# hams-node end member certificate keys'
sections() { uci -q show dropbear | sed -n 's/^dropbear\.\([^.=]*\)=dropbear$/\1/p'; }
restart() { [ -x /etc/init.d/dropbear ] && /etc/init.d/dropbear restart; return 0; }

norm() { printf '%s' "$1" | tr 'A-F' 'a-f' | sed 's/^0*//'; }
revoked() { # revoked SERIAL: the serial is on the deprecation list
	[ -r "$deplist" ] || return 1
	want=$(norm "$1")
	for line in $(grep '^cert:' "$deplist" | cut -d' ' -f1); do [ "$(norm "${line##*:}")" = "$want" ] && return 0; done
	return 1
}
# sync_keys: rewrite the marked block of the authorized keys from STATE_DIR/ssh_keys, leaving every other line as it is.
sync_keys() {
	mkdir -p "$(dirname "$keys")"
	touch "$keys"
	new=$keys.new
	awk -v b="$begin" -v e="$end" '$0 == b {skip = 1; next} $0 == e {skip = 0; next} !skip' "$keys" > "$new"
	block=
	if [ -r "$sshkeys" ]; then
		while read -r serial type blob rest; do
			case $serial$type$blob in '' | *[!A-Za-z0-9+/=-]*) continue ;; esac
			case $type in ecdsa-sha2-nistp256) ;; *) continue ;; esac
			revoked "$serial" && continue
			block="$block$type $blob hams-cert-$serial
"
		done < "$sshkeys"
	fi
	[ -z "$block" ] || printf '%s\n%s%s\n' "$begin" "$block" "$end" >> "$new"
	chmod 600 "$new"
	mv "$new" "$keys"
}

do_apply() {
	[ -s "$state/device_token" ] || { echo "hams-node-ssh: not enrolled; SSH unchanged" >&2; return 0; }
	sync_keys
	grep -qE '^(ssh-|ecdsa-|sk-)' "$keys" 2>/dev/null || {
		if [ -f "$orig" ]; then echo "hams-node-ssh: no authorized key left; SSH refuses every login (passwords stay off; recovery is a physical reset and enrolling again)" >&2
		else echo "hams-node-ssh: no authorized key yet; password login kept until one exists (export a member certificate or add a key in LuCI)" >&2; fi
		return 0
	}
	[ -f "$orig" ] || for s in $(sections); do
		echo "$s $(uci -q get "dropbear.$s.PasswordAuth") $(uci -q get "dropbear.$s.RootPasswordAuth")" >> "$orig"
	done
	for s in $(sections); do
		uci set "dropbear.$s.PasswordAuth=off"
		uci set "dropbear.$s.RootPasswordAuth=off"
	done
	uci commit dropbear
	restart
	echo "hams-node-ssh: SSH now accepts keys only" >&2
}

do_off() {
	if [ -f "$keys" ] && grep -qxF "$begin" "$keys"; then
		awk -v b="$begin" -v e="$end" '$0 == b {skip = 1; next} $0 == e {skip = 0; next} !skip' "$keys" > "$keys.new"
		mv "$keys.new" "$keys"
	fi
	rm -f "$sshkeys"
	[ -f "$orig" ] || return 0
	while read -r s pw rpw; do
		if [ -n "$pw" ]; then uci set "dropbear.$s.PasswordAuth=$pw"; else uci -q delete "dropbear.$s.PasswordAuth"; fi
		if [ -n "$rpw" ]; then uci set "dropbear.$s.RootPasswordAuth=$rpw"; else uci -q delete "dropbear.$s.RootPasswordAuth"; fi
	done < "$orig"
	uci commit dropbear
	rm -f "$orig"
	restart
}

case $1 in
apply) do_apply ;;
off) do_off ;;
*) exit 2 ;;
esac
