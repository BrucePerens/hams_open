#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# hams-node-ondemand: WireGuard peers for member /60s, made on the first packet and removed when idle.
#   hams-node-ondemand OPTIONS packet ADDRESS   first traffic to ADDRESS: look the /60 up and add the peer
#   hams-node-ondemand OPTIONS expire           remove peers whose /60 has seen no traffic for the idle time
#   hams-node-ondemand OPTIONS run              follow the nft "seen" set (events) and do both
# Traffic is seen by the nft set "inet hams_ondemand seen" (keyed on the /60, timeout = idle time, refreshed by every
# packet), so a peer is idle exactly when its /60 has left that set. WireGuard encrypts, so it is never put on a radio link
# (47 CFR 97.113(a)(4)): the link type must be "internet".
# OPTIONS: -i INTERFACE -t LINK_TYPE -u LOOKUP_URL -s STATE_DIR [-m MAX_PEERS (256)] [-c CERT -k KEY]
set -u
max=256 cert='' key=''
while getopts i:t:u:s:m:c:k: opt; do
	case $opt in
	i) iface=$OPTARG ;; t) type=$OPTARG ;; u) url=$OPTARG ;; s) state=$OPTARG ;; m) max=$OPTARG ;; c) cert=$OPTARG ;; k) key=$OPTARG ;;
	*) exit 2 ;;
	esac
done
shift $((OPTIND - 1))
: "${iface:=}" "${type:=}" "${url:=}" "${state:=}"
[ -n "$iface" ] && [ -n "$state" ] && [ $# -ge 1 ] || { echo "usage: hams-node-ondemand -i IF -t TYPE -u URL -s DIR [-m N] packet ADDR|expire|run" >&2; exit 2; }
[ "$type" = internet ] || { echo "hams-node-ondemand: refusing WireGuard on a '$type' link" >&2; exit 1; }
case $iface in '' | *[!A-Za-z0-9_-]*) echo "hams-node-ondemand: bad interface name" >&2; exit 1 ;; esac
mkdir -p "$state" || exit 1
# the on-demand peers' interface is a ham interface: zone ham
if command -v hams-node-fw >/dev/null 2>&1; then hams-node-fw ensure "$iface" || exit 1; fi
peers=$state/peers refused=$state/refused checked=$state/checked
touch "$peers" "$refused" "$checked"
# A peer is looked up again after this many seconds; one the directory no longer returns (suspended, disabled, released, key changed) is evicted.
recheck=300
# Keys and prefixes of rogue routers (hams-node-status keeps this list): never a new tunnel to one.
deplist=${HAMS_NODE_DEPRECATION_LIST:-/etc/hams-node/deprecation_list}
deprecated() { [ -r "$deplist" ] && grep -q "^$1 " "$deplist"; }

# The first 60 bits of an IPv6 address (15 hex digits), so equal values mean "same /60".
key60() {
	echo "$1" | awk '{
		a = $1; sub(/\/.*/, "", a)
		n = split(a, p, "::")
		l = (p[1] == "") ? 0 : split(p[1], L, ":")
		r = (n > 1 && p[2] != "") ? split(p[2], R, ":") : 0
		s = ""
		for (i = 1; i <= 8; i++) {
			if (i <= l) v = L[i]; else if (i > 8 - r) v = R[i - (8 - r)]; else v = "0"
			while (length(v) < 4) v = "0" v
			s = s tolower(v)
		}
		print substr(s, 1, 15)
	}'
}

# The /60s with traffic in the idle window, one key60 per line.
active() {
	nft list set inet hams_ondemand seen 2>/dev/null | grep -o '[0-9a-fA-F:]*:[0-9a-fA-F:]*' | while read -r a; do key60 "$a"; done
}

remove_peer() { # public key
	wg set "$iface" peer "$1" remove
	grep -v "^$1 " "$peers" > "$peers.new"; mv "$peers.new" "$peers"
	grep -v "^$1 " "$checked" > "$checked.new"; mv "$checked.new" "$checked"
}

# lookup ADDRESS: asks the directory; sets rst, rpk, rep, rpfx (rpk empty unless the record is well formed).
lookup() {
	qaddr=$1
	set -- -q -O -
	[ -n "$cert" ] && set -- "$@" --certificate "$cert" --private-key "$key"
	reply=$(uclient-fetch "$@" --header 'Content-Type: application/json' --post-data "{\"jsonrpc\":\"2.0\",\"params\":{\"query\":\"$qaddr\"}}" "$url" 2>/dev/null)
	echo "$reply" > "$state/reply.json"
	rst=$(jsonfilter -i "$state/reply.json" -e '@.result.status' 2>/dev/null)
	rpk=$(jsonfilter -i "$state/reply.json" -e '@.result.public_key') && rep=$(jsonfilter -i "$state/reply.json" -e '@.result.endpoint') \
		&& rpfx=$(jsonfilter -i "$state/reply.json" -e '@.result.prefix60')
	case "${rpk:-}${rep:-}${rpfx:-}" in *[!A-Za-z0-9+/=.:_[]/-]*) rpk='' ;; esac
}

# valid_record K60: the looked-up record is a usable one for that /60.
valid_record() {
	[ "${rst:-}" = success ] && [ -n "${rpk:-}" ] && [ "$(key60 "${rpfx:-}")" = "$1" ] && [ "${rpfx#*/}" = 60 ]
}

do_expire() {
	act=$(active)
	while read -r pk k60 rest; do
		[ -n "$pk" ] || continue
		echo "$act" | grep -qx "$k60" || remove_peer "$pk"
	done < "$peers"
	# Peers that stay busy are still checked against the directory now and then: a member suspended or disabled after the tunnel came up
	# (or whose key changed, or who is on the deprecation list) is no longer returned, and the tunnel goes.
	now=$(date +%s)
	while read -r pk k60 pfx rest; do
		[ -n "$pk" ] || continue
		if deprecated "$pk"; then remove_peer "$pk"; continue; fi
		last=$(grep "^$pk " "$checked" | tail -n 1 | cut -d' ' -f2)
		[ -n "$last" ] && [ $((now - last)) -lt "$recheck" ] && continue
		lookup "${pfx%/*}"
		[ -n "${rst:-}" ] || continue # hams.com unreachable: keep the peer, ask again next time
		if valid_record "$k60" && [ "$rpk" = "$pk" ]; then
			grep -v "^$pk " "$checked" > "$checked.new"; echo "$pk $now" >> "$checked.new"; mv "$checked.new" "$checked"
		else
			remove_peer "$pk"
		fi
	done < "$peers"
}

do_packet() {
	addr=$1
	case $addr in '' | *[!0-9a-fA-F:]*) echo "hams-node-ondemand: bad address" >&2; return 1 ;; esac
	k=$(key60 "$addr") now=$(date +%s)
	grep -q " $k " "$peers" && return 0
	last=$(grep "^$k " "$refused" | tail -n 1 | cut -d' ' -f2)
	[ -n "$last" ] && [ $((now - last)) -lt 60 ] && return 0
	lookup "$addr"
	# hams.com unreachable (no answer with a status): use the last good entry for this /60, so a re-connect never needs the internet.
	# An explicit answer (not found, suspended) drops the cached entry.
	cache=$state/directory.cache
	touch "$cache"
	if [ -z "${rst:-}" ]; then
		line=$(grep "^$k " "$cache" | tail -n 1)
		[ -n "$line" ] && rst=success rpk=$(echo "$line" | cut -d' ' -f2) rep=$(echo "$line" | cut -d' ' -f3) rpfx=$(echo "$line" | cut -d' ' -f4)
	fi
	# unknown, suspended, stale, mismatching or deprecated records: nothing is created, and the address is not asked about again for a minute
	if ! valid_record "$k" || deprecated "$rpk"; then
		grep -v "^$k " "$refused" > "$refused.new"; echo "$k $now" >> "$refused.new"; mv "$refused.new" "$refused"
		[ -z "$(jsonfilter -i "$state/reply.json" -e '@.result.status' 2>/dev/null)" ] || { grep -v "^$k " "$cache" > "$cache.new"; mv "$cache.new" "$cache"; }
		return 0
	fi
	pk=$rpk ep=$rep pfx=$rpfx
	grep -v "^$k " "$cache" > "$cache.new"; echo "$k $pk $ep $pfx" >> "$cache.new"; mv "$cache.new" "$cache"
	if [ "$(wc -l < "$peers")" -ge "$max" ]; then # full: the oldest idle peer goes first, else the oldest peer
		act=$(active) victim=''
		while read -r vpk vk rest; do
			echo "$act" | grep -qx "$vk" || { victim=$vpk; break; }
		done < "$peers"
		[ -n "$victim" ] || victim=$(head -n 1 "$peers" | cut -d' ' -f1)
		remove_peer "$victim"
	fi
	wg set "$iface" peer "$pk" endpoint "$ep" allowed-ips "$pfx" || return 1
	echo "$pk $k $pfx $ep" >> "$peers"
	echo "$pk $now" >> "$checked"
}

case $1 in
packet) [ $# -eq 2 ] || exit 2; do_packet "$2" ;;
expire) do_expire ;;
run)
	nft monitor new elements 2>/dev/null | while read -r line; do
		for a in $(echo "$line" | grep -o '[0-9a-fA-F:]*:[0-9a-fA-F:]*'); do do_packet "$a"; done
		do_expire
	done
	;;
*) exit 2 ;;
esac
