<odoo>
    <data noupdate="1">
        <record model="res.groups.privilege" id="privilege_zero_sudo">
            <field name="name">Zero Sudo Services</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_mail_service" model="res.groups">
            <field name="name">Central Mail Service Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>

        <record id="group_odoo_facility_service" model="res.groups">
            <field name="name">Odoo Facility Service Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>

        <record id="group_config_service" model="res.groups">
            <field name="name">Central Configuration Service Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>

        <record id="group_cache_invalidator" model="res.groups">
            <field name="name">Central Cache Invalidation Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>

        <!-- Referenced (as "zero_sudo.gdpr_service_internal") by
             user_websites/models/res_users.py's _execute_gdpr_erasure()
             override, but never actually defined anywhere, so every call to
             erase a user's website pages/blog posts/blogs crashed with
             "Service Account not found". zero_sudo is the correct shared
             home for this (not a hams_com-only module like ham_base) since
             hams_open modules like user_websites and compliance need it
             and cannot depend the other direction. Each module that owns
             erasable content grants this group access to its own models
             (see user_websites/security/ir.model.access.csv), the same
             distributed-grant pattern already used for group_mail_service. -->
        <record id="group_gdpr_service" model="res.groups">
            <field name="name">Central GDPR Erasure Service Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>

        <!-- Referenced by hams_base/controllers/unsubscribe.py's
             unsubscribe_lockout() route: core Odoo's res.users.write()
             unconditionally refuses `active=False` when the acting
             env.uid is one of the ids being written (see
             odoo/addons/base/models/res_users.py write(), "You cannot
             deactivate the user you're currently logged in as."), so a
             user can never deactivate their own live-session account
             through their own uid, sudo() or not. This narrow,
             single-purpose service account exists to perform exactly
             that one write on the calling user's own behalf, with an
             ACL grant scoped to res.users only (see
             hams_base/security/ir.model.access.csv), not reusing
             group_gdpr_service, which is a different module's
             (user_websites) account for a different purpose and isn't
             even installed alongside every module that might need this. -->
        <record id="group_account_lockout_service" model="res.groups">
            <field name="name">Central Account Lockout Service Group</field>
            <field name="privilege_id" ref="privilege_zero_sudo"/>
        </record>
    </data>
    <data>
        <record id="mail_service_internal" model="res.users">
            <field name="name">Central Mail Service Account</field>
            <field name="login">mail_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <!-- base.group_user (plain "Internal User") is needed on top of
                 the narrow group_mail_service ACLs above: several fields
                 this account legitimately needs while actually sending
                 mail, e.g. message_follower_ids and mail.template's
                 report_template_ids resolution against ir.actions.report,
                 are core Odoo fields/models gated behind base.group_user
                 specifically, not just a model-level ir.model.access.csv
                 row. Without it, routine send_mail()/message_post() calls
                 through this account failed with AccessError. This grants
                 the same baseline internal-employee read access any real
                 Odoo user sending mail already has, not a new capability,
                 just what the account's actual job already requires. -->
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_mail_service'), ref('base.group_user')])]"/>
        </record>

        <record id="gdpr_service_internal" model="res.users">
            <field name="name">Central GDPR Erasure Service Account</field>
            <field name="login">gdpr_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_gdpr_service')])]"/>
        </record>

        <record id="orphaned_record_owner" model="res.users">
            <!-- Not an acting service account, never with_user()'d, never performs an
                 operation as itself. Exists purely as a stable, presentable Many2one target
                 for "public record, ownership anonymized" fields (ham.qso.owner_user_id,
                 ham.contest.score.user_id, event.event.net_control_id, and similar) once a
                 real user's GDPR erasure runs: reassigning ownership to this record avoids
                 both weakening required=True fields to nullable and scattering
                 null-ownership display handling across every view/report that shows these
                 public RF/contest/net records; see MASTER_02. Holds no groups at all: it
                 never authenticates or authorizes anything, so it needs no privileges. -->
            <field name="name">Anonymized User (GDPR Erasure)</field>
            <field name="login">orphaned_record_owner_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
        </record>

        <record id="odoo_facility_service_internal" model="res.users">
            <field name="name">Odoo Facility Service Account</field>
            <field name="login">odoo_facility_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_odoo_facility_service'), ref('base.group_user')])]"/>
        </record>

        <record id="config_service_internal" model="res.users">
            <field name="name">Central Configuration Service Account</field>
            <field name="login">config_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_config_service')])]"/>
        </record>

        <record id="cache_invalidation_service_internal" model="res.users">
            <field name="name">Central Cache Invalidation Service Account</field>
            <field name="login">cache_invalidation_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_cache_invalidator')])]"/>
        </record>

        <record id="user_lockout_service_internal" model="res.users">
            <field name="name">Central Account Lockout Service Account</field>
            <field name="login">user_lockout_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('zero_sudo.group_account_lockout_service')])]"/>
        </record>

    </data>
</odoo>
