<odoo>
    <data noupdate="1">
        <record id="group_tenant_sites_manager" model="res.groups">
            <field name="name">Tenant sites: manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="group_tenant_sites_service" model="res.groups">
            <field name="name">Service Account: Tenant sites request router</field>
        </record>
    </data>
    <data>
        <!-- [@ANCHOR: tenant_sites:COMM_service_account_acl] The request router reads the host tables as
             this account only; the anonymous public user has no access to any tenant_sites model.
             Verified by [@ANCHOR: tenant_sites:COMM_test_service_account_acl] -->
        <record id="user_tenant_sites_service" model="res.users">
            <field name="name">Tenant sites request router</field>
            <field name="login">tenant_sites_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('tenant_sites.group_tenant_sites_service')])]"/>
        </record>
    </data>
</odoo>
