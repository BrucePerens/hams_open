<odoo>
    <data noupdate="1">
    <!-- Each service group named below reads and writes only its own ir.config_parameter keys (no service account has table-wide access). get_param/set_param go through
         ham_base's override and the config service account, which is the one table-wide group, so these rules limit only direct ORM access. -->
    <record id="rule_config_parameter_purge_read" model="ir.rule">
        <field name="name">ir.config_parameter: purge reads its own keys</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="groups" eval="[(4, ref('cloudflare.group_cloudflare_purge'))]"/>
        <field name="domain_force">[('key', '=like', 'cloudflare.%')]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_config_parameter_trusted_ip_read" model="ir.rule">
        <field name="name">ir.config_parameter: trusted ip reads its own keys</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="groups" eval="[(4, ref('cloudflare.group_cloudflare_trusted_ip'))]"/>
        <field name="domain_force">[('key', 'in', ['cloudflare.trusted_ip_ranges_auto', 'cloudflare.trusted_ip_ranges_custom', 'cloudflare.trusted_ip_ranges_last_refreshed', 'cloudflare.trust_non_tunnel_peers'])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_config_parameter_trusted_ip_write" model="ir.rule">
        <field name="name">ir.config_parameter: trusted ip writes its own keys</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="groups" eval="[(4, ref('cloudflare.group_cloudflare_trusted_ip'))]"/>
        <field name="domain_force">[('key', 'in', ['cloudflare.trusted_ip_ranges_auto', 'cloudflare.trusted_ip_ranges_last_refreshed'])]</field>
        <field name="perm_read" eval="False"/>
    </record>
    </data>
</odoo>
