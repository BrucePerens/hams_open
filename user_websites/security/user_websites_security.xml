<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_user_websites">
            <field name="name">User Websites</field>
            <field name="description">User rights for the User Websites module.</field>
            <field name="sequence">40</field>
        </record>

        <record model="res.groups.privilege" id="privilege_user_websites">
            <field name="name">Website Access</field>
            <field name="category_id" ref="module_category_user_websites"/>
        </record>

        <record id="group_user_websites_user" model="res.groups">
            <field name="name">User Website Owner</field>
            <field name="privilege_id" ref="privilege_user_websites"/>
        </record>

        <!--
            Every internal AND portal user gets baseline User Websites access
            by default, matching post_init_hook's own install-time backfill
            (which grants this group to every existing real user, `u.id > 0`
            and not the public user, regardless of internal/portal status;
            confirmed against that hook's own SQL, and against
            test_lifecycle_and_groups.py's own use of base.group_portal
            users to exercise this module's create-site flow, since "sign up
            for a personal ham-radio website" is a portal-user-facing
            feature, not an internal-staff one). Without this, post_init_hook's
            backfill only covers users that already existed at install time;
            any user created afterward would get zero User Websites module
            access unless manually granted this group. Appending to each
            base group's own implied_ids (rather than replacing it) is the
            standard Odoo idiom for "every user of this kind gets this by
            default".
        -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
        </record>
        <record id="base.group_portal" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
        </record>

        <record id="group_user_websites_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_user_websites"/>
            <field name="implied_ids" eval="[(4, ref('user_websites.group_user_websites_user')), (4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Service-account privilege audit, 2026-09-14 (bug-hunt): a
             capability-only group carrying NO ir.model.access rows and NO
             ir.rule of its own, anywhere. Its one and only meaning is the
             boolean UserWebsitesOwnedMixin checks in
             _check_proxy_ownership_create()/_check_proxy_ownership_write():
             "this actor may create a record owned by someone else / with no
             owner, and may change owner_user_id/user_websites_group_id after
             creation." Before this group existed, the only way for a service
             account in another module (GDPR erasure, DNS zone provisioning,
             public event-issue and repeater-report intake) to get that one
             bypass was to join group_user_websites_service_account below,
             which also carries full create/write/unlink on res.groups,
             ir.ui.view, website.rewrite, mail.followers, discuss.channel.member
             and more (see ir.model.access.csv). Those accounts now hold this
             group instead. test_ownership_bypass_group.py enforces the
             "no grants of its own" invariant mechanically. -->
        <record id="group_user_websites_ownership_bypass" model="res.groups">
            <field name="name">Service Capability: Proxy Ownership Bypass</field>
        </record>

        <record id="group_user_websites_service_account" model="res.groups">
            <field name="name">Service Account: User Websites Provisioning</field>
            <!-- Its implied_ids link to the bypass group lives in the
                 noupdate="0" block at the end of this file, NOT here: this
                 whole block is noupdate="1", so a link added here would be
                 created on a fresh install but silently skipped on an upgrade
                 of any existing database, leaving every account that relies
                 on the implication without the mixin bypass. -->
        </record>

        <record id="website_page_svc_rule" model="ir.rule">
            <field name="name">Website Page Service Account Rule</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_service_account'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_post_svc_rule" model="ir.rule">
            <field name="name">Blog Post Service Account Rule</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_service_account'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_blog_svc_rule" model="ir.rule">
            <field name="name">Blog Service Account Rule</field>
            <field name="model_id" ref="website_blog.model_blog_blog"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_service_account'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="website_page_admin_rule" model="ir.rule">
            <field name="name">Website Page Admin Rule</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_post_admin_rule" model="ir.rule">
            <field name="name">Blog Post Admin Rule</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_blog_admin_rule" model="ir.rule">
            <field name="name">Blog Admin Rule</field>
            <field name="model_id" ref="website_blog.model_blog_blog"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="website_page_group_rule" model="ir.rule">
            <field name="name">Website Page Group Rule</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('user_websites_group_id.odoo_group_id.user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_post_group_rule" model="ir.rule">
            <field name="name">Blog Post Group Rule</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('user_websites_group_id.odoo_group_id.user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- content.violation.report's own ir.rules (user/multi-company/
             admin/service-account) moved to content_moderation on
             2026-09-23: that module now owns the model. The admin rule
             became content_moderation.content_violation_report_moderator_rule,
             re-pointed at content_moderation's own group
             (group_content_moderation_moderator); group_user_websites_
             administrator is wired into that group via `implied_ids` below
             (noupdate="0" block) rather than re-declaring an
             unconditional [(1,'=',1)] rule here, to avoid recreating the
             exact OR-domination leak the comment that used to live at this
             spot (content_violation_report_service_account_rule, removed)
             documented and fixed on 2026-09-09: the service account gets
             its own company-scoped rule on content_moderation's side
             (content_violation_report_service_account_rule there), never
             the moderator's unconditional one, via its own separate
             `implied_ids` link below, see that block's own comment. -->

        <record id="website_page_private_rule" model="ir.rule">
            <field name="name">Website Page Private Rule</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_post_private_rule" model="ir.rule">
            <field name="name">Blog Post Private Rule</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="website_page_published_read_rule" model="ir.rule">
            <field name="name">Website Page Published Read Rule</field>
            <field name="model_id" ref="website.model_website_page"/>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Bug-hunt fix (docs/bug_hunt_claims/.../published_read_rules.md, 2026-09-12): this
             rule's domain used to be [('is_published', '=', True)], a different field from stock
             Odoo's own website_blog_post_public rule ([('website_published', '=', True)],
             website_blog/security/website_blog_security.xml), which also matches
             base.group_public/base.group_portal on this same model. Since Odoo OR-combines
             same-model group-scoped rule domains, and website_published (a computed field:
             is_published AND (no website_id OR website_id matches the current website)) implies
             is_published but not the reverse, the OR-combined domain optimized to the broader
             is_published alone: silently stripping stock's own current-website scoping. In a
             multi-website deployment (a real, provisioned configuration here: the service account
             holds website.group_multi_website), a blog.post published on one website became
             readable by a visitor browsing a different one. Fixed by matching stock's own field
             exactly, keeping this rule's broader group list (it also covers
             group_user_websites_user, which stock's rule doesn't). -->
        <record id="blog_post_published_read_rule" model="ir.rule">
            <field name="name">Blog Post Published Read Rule</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('website_published', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Bug-hunt fix (docs/bug_hunt_claims/.../published_read_rules.md, 2026-09-12): this
             rule's domain used to be [(1, '=', 1)] (unconditional), while stock Odoo's own
             website_blog_public rule (same model, same base.group_public/base.group_portal
             groups) restricts to [('active', '=', True)]. Odoo OR-combines same-model
             group-scoped rule domains, so [('active','=',True)] OR (1,'=',1) optimizes to
             (1,'=',1): this module's own rule silently nullified stock's own archived/
             soft-deleted-record filter, letting any public or portal caller read every blog.blog
             record regardless of its active flag. Fixed by matching stock's own domain exactly,
             keeping this rule's broader group list (it also covers group_user_websites_user,
             which stock's rule doesn't). -->
        <record id="blog_blog_published_read_rule" model="ir.rule">
            <field name="name">Blog Published Read Rule</field>
            <field name="model_id" ref="website_blog.model_blog_blog"/>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="blog_blog_private_rule" model="ir.rule">
            <field name="name">Blog Private Rule</field>
            <field name="model_id" ref="website_blog.model_blog_blog"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('owner_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="blog_blog_group_rule" model="ir.rule">
            <field name="name">Blog Group Rule</field>
            <field name="model_id" ref="website_blog.model_blog_blog"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_user'))]"/>
            <field name="domain_force">[('user_websites_group_id.odoo_group_id.user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="content_violation_appeal_user_rule" model="ir.rule">
            <field name="name">Content Violation Appeal User Rule</field>
            <field name="model_id" ref="model_content_violation_appeal"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="content_violation_appeal_multi_company_rule" model="ir.rule">
            <field name="name">Content Violation Appeal Multi-Company Rule</field>
            <field name="model_id" ref="model_content_violation_appeal"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
