            <field name="model_id" ref="model_content_violation_appeal"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_administrator'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Bug-hunt fix (2026-09-12): mirrors content_violation_report_service_account_rule's
             own 2026-09-09 fix above, exactly the same shape and same root cause: the service
             account used to share the Administrator's own unconditional [(1,'=',1)] rule, which
             OR dominates content_violation_appeal_multi_company_rule's own company_id scoping
             (Odoo combines same-model group-matching rule domains with OR). No current caller
             does a with_company(company)-scoped count()/search() against content.violation.appeal
             the way _cron_notify_pending_reports does for content.violation.report (checked:
             grepped for with_company against this model, zero hits), so unlike the report-model
             bug, this one is LATENT, not confirmed live, but the structural flaw is identical and
             would produce the same cross-company leak the moment anything iterates companies
             against this model the way the report cron does. Administrator is kept cross-company
             deliberately, same reasoning as the report rule; the service account gets its own
             rule scoped exactly like an ordinary user's. -->
        <record id="content_violation_appeal_service_account_rule" model="ir.rule">
            <field name="name">Content Violation Appeal Service Account Rule</field>
            <field name="model_id" ref="model_content_violation_appeal"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_service_account'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="user_websites_group_multi_company_rule" model="ir.rule">
            <field name="name">User Websites Group Multi-Company Rule</field>
            <field name="model_id" ref="model_user_websites_group"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Bug-hunt fix (docs/bug_hunt_claims/.../acl_user_websites_group.md, 2026-09-12):
             base.group_portal and base.group_public each have their own read-only ACL row on this
             model (access_user_websites_group_user/_public), but neither group matched the rule
             above (base.group_user only): per the "no matching group rule = fully unrestricted"
             mechanism, that left both groups with unscoped, cross-company read of every
             user.websites.group record platform-wide, including violation_strike_count and
             is_suspended_from_websites, which read as internal moderation data rather than public-
             directory data. Confirmed live for portal (a real, password-authenticated login that
             can call /web/dataset/call_kw directly); the public row is latent in practice (the
             generic RPC endpoint requires an authenticated session, which an anonymous website
             visitor's request never has), but fixed for both since the mechanism is identical and
             perm_write/create/unlink stay 0 for both groups regardless of this rule's own
             all-True perm flags (ir.rule can only narrow which records are visible, never grant an
             operation the ACL itself doesn't already allow). -->
        <!-- The provisioning service account is not in base.group_user, so
             user_websites_group_multi_company_rule above never applied to it
             on its own. It only looked company-scoped while the account also
             held group_user_websites_administrator, which implies
             base.group_user. Without a rule of its own, no group rule would
             match it and it would read and write every company's groups. -->
        <record id="user_websites_group_service_account_rule" model="ir.rule">
            <field name="name">User Websites Group Service Account Rule</field>
            <field name="model_id" ref="model_user_websites_group"/>
            <field name="groups" eval="[(4, ref('user_websites.group_user_websites_service_account'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="user_websites_group_multi_company_rule_portal_public" model="ir.rule">
            <field name="name">User Websites Group Multi-Company Rule (Portal/Public)</field>
            <field name="model_id" ref="model_user_websites_group"/>
            <field name="groups" eval="[(4, ref('base.group_portal')), (4, ref('base.group_public'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
    <data noupdate="0">
        <!-- Service-account privilege audit, 2026-09-14: the full provisioning
             group implies the capability-only bypass group, so
             user_websites_service_account itself (and any account that
             legitimately needs the whole provisioning ACL) keeps the
             UserWebsitesOwnedMixin bypass without a second explicit
             membership. Kept in its own noupdate="0" block so the link is
             applied on upgrade of an existing database too, not only on a
             fresh install (see the group's own comment above). -->
        <!-- A <function> write rather than a <record>: convert.py's function tag
             binds the first <value> (the group's own id) as the receiver and
             passes the second as write()'s vals, the same shape
             ham_dns/security/security_data.xml already uses for a res.users
             membership change, and it re-runs on every upgrade, which a
             <record> in a noupdate="1" block would not. -->
        <function model="res.groups" name="write">
            <value eval="[ref('user_websites.group_user_websites_service_account')]"/>
            <value eval="{'implied_ids': [(4, ref('user_websites.group_user_websites_ownership_bypass'))]}"/>
        </function>

        <!-- content_moderation extraction (2026-09-23): wire this module's
             own two moderation-adjacent groups into content_moderation's
             own two groups, deliberately kept SEPARATE (not merged into a
             single implication) to preserve the exact split
             content_violation_report_admin_rule/_service_account_rule used
             to enforce before the extraction moved them: the human
             Administrator role gets the unconditional cross-company
             moderator rule, the service account gets only the
             company-scoped one. Giving the service account the moderator
             group too would OR-dominate its own company scoping right back
             into existence: the exact bug content_violation_report_
             service_account_rule's own 2026-09-09 fix (removed from this
             file, now living on content_moderation's side) exists to
             prevent; test_audit_edge_cases.py::
             test_10_cron_pending_report_count_does_not_leak_across_companies
             is the regression guard for that. Both writes belong in this
             noupdate="0" block, not as `implied_ids` on the noupdate="1"
             group records above, for the same upgrade-safety reason the
             ownership-bypass link above already documents: an existing
             (already-installed) database skips noupdate="1" data on
             upgrade, so a link added only there would never reach
             hams_prod's own real group rows. -->
        <function model="res.groups" name="write">
            <value eval="[ref('user_websites.group_user_websites_administrator')]"/>
            <value eval="{'implied_ids': [(4, ref('content_moderation.group_content_moderation_moderator'))]}"/>
        </function>
        <function model="res.groups" name="write">
            <value eval="[ref('user_websites.group_user_websites_service_account')]"/>
            <value eval="{'implied_ids': [(4, ref('content_moderation.group_content_moderation_service_account'))]}"/>
        </function>
    </data>
</odoo>
