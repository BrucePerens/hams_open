<odoo>
    <template id="layout_inherit_report_violation" inherit_id="website.layout" name="Report Violation Global"> 
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_xpath_rendering_layout] -->
        <!-- This template injects two independent features covered by the
             same test method (test_06_layout_templates): the report-violation
             dropzone below, and the xpath render pattern immediately after. -->
        <!-- Verified by [@ANCHOR: test_dropzone_layout] -->

        <!-- Verified by [@ANCHOR: test_xpath_rendering_layout] -->

        <!-- [@ANCHOR: xpath_rendering_layout] -->
        <!-- The audit-ignore-xpath bypass below is specific to this xpath
             injection, distinct from the template-level audit-ignore-view
             bypass declared above. -->
        <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_layout] -->
        <xpath expr="//footer" position="after">
            <div id="user_websites_dropzone_layout">
                <!-- [@ANCHOR: dropzone_layout] -->
            </div>
            <t t-call="user_websites.report_violation_modal"/>
        </xpath>

        <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_layout] -->
        <xpath expr="//footer" position="before">
            <t t-set="is_user_content" t-value="False"/>
            <t t-set="is_owner" t-value="False"/>

            <!-- [@ANCHOR: report_violation_scoped_to_personal_website_content]
                 profile_user/profile_group (set generically by layout_inherit_user_navbar for
                 ANY main_object carrying user_websites.owned.mixin) are not specific to a
                 personal website: many unrelated models adopt that mixin purely for
                 ownership/claim tracking (event.event, ham.repeater, ham.classifieds listings,
                 training progress records, and more). Without this extra check, the
                 report-violation widget (meant for flagging an abusive personal operator
                 website) leaked onto every page type that happens to use the mixin, with a
                 help link pointing at personal-website documentation that has nothing to do
                 with the page it appears on.

                 A real personal-website page is one of two shapes: main_object is one of the
                 content models user_websites itself defines (website.page, blog.blog,
                 blog.post), or, on the "profile home"/"blog listing" routes in
                 controllers/main.py, main_object IS the profile owner record itself
                 (main_object = profile_user or profile_group, set explicitly by those
                 controllers). Checking main_object._name against a fixed model list alone
                 would have wrongly hidden the widget on that second shape (main_object there
                 is res.users/user.websites.group, not a content sub-model); checking identity
                 against profile_user/profile_group instead ties the gate to the actual
                 semantic relationship rather than a duplicated, driftable model-name list.
                 Verified by [@ANCHOR: test_report_violation_scoped_to_personal_website] -->
            <t t-if="(profile_user or profile_group) and main_object and (main_object._name in ('website.page', 'blog.blog', 'blog.post') or main_object == profile_user or main_object == profile_group)">
                <t t-set="is_user_content" t-value="True"/>
                <t t-if="profile_user and profile_user.id == uid">
                    <t t-set="is_owner" t-value="True"/>
                </t>
                <t t-elif="profile_group and uid in profile_group.odoo_group_id.user_ids.ids">
                    <t t-set="is_owner" t-value="True"/>
                </t>
            </t>

            <t t-if="is_user_content and not is_owner">
                <div class="container mt-4 mb-4 border-top pt-3">
                    <t t-call="user_websites.report_violation_snippet"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
