<odoo>

    <template id="user_navbar" name="User Websites Navbar">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-if="resolved_slug">
            <a class="visually-hidden-focusable uw-skip-link" href="#wrap">Skip to content</a>
            <t t-if="is_owner and not request.params.get('visitor')">
                <t t-call="user_websites.owner_toolbar"/>
            </t>
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom user-websites-navbar" aria-label="Site menu">
                <div class="container">
                    <a class="navbar-brand fw-bold" t-attf-href="/#{resolved_slug}">
                        <t t-if="profile_user">
                            <img t-attf-src="/web/image/res.users/#{profile_user.id}/avatar_128?unique=#{profile_user.write_date and int(profile_user.write_date.timestamp()) or 0}" width="30" height="30" class="d-inline-block align-top rounded-circle me-2" alt=""/>
                            <span class="uw-callsign" t-out="resolved_slug.upper()"/>
                            <span t-if="profile_user.name and profile_user.name.lower() != resolved_slug" class="fw-normal text-muted ms-2" t-out="profile_user.name"/>
                        </t>
                        <t t-elif="profile_group">
                            <i class="fa fa-users me-2" aria-hidden="true"/> <t t-out="profile_group.name"/>
                        </t>
                        <t t-else="">
                            <span class="uw-callsign" t-out="resolved_slug.upper()"/>
                        </t>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNavbarNav" aria-controls="userNavbarNav" aria-expanded="false" aria-label="Toggle site menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="userNavbarNav">
                        <ul class="navbar-nav me-auto" id="user_navbar_nav_links">
                            <li class="nav-item">
                                <a class="nav-link" t-attf-href="/#{resolved_slug}">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" t-attf-href="/#{resolved_slug}/blog">Blog</a>
                            </li>
                            <t t-foreach="((profile_user or profile_group) and (profile_user or profile_group)._user_websites_menu_pages()) or []" t-as="menu_page">
                                <li class="nav-item">
                                    <a class="nav-link" t-att-href="menu_page['url']"><t t-out="menu_page['name']"/></a>
                                </li>
                            </t>
                        </ul>
                        <div id="user_websites_dropzone_navbar_actions">
                            <!-- [@ANCHOR: dropzone_navbar_actions] -->

                            <!-- Tested by [@ANCHOR: test_dropzone_navbar_actions] -->
                        </div>
                    </div>
                </div>
            </nav>
        </t>
    </template>

    <template id="member_site_footer" name="Member Site Footer">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_member_site_has_no_hams_chrome] -->
        <footer t-if="member_site and resolved_slug" class="uw-member-footer border-top bg-light py-3 mt-5" aria-label="Site footer">
            <div class="container d-flex flex-wrap gap-3 justify-content-between align-items-center small">
                <span><t t-out="resolved_slug.upper()"/> &#183; a <a href="https://hams.com/">Hams.com</a> member site</span>
                <span class="d-flex flex-wrap gap-3 align-items-center">
                    <t t-if="not is_owner"><t t-call="user_websites.report_violation_snippet"/></t>
                    <a href="/privacy">Privacy</a>
                    <a href="/terms">Terms</a>
                </span>
            </div>
        </footer>
    </template>

    <template id="layout_inherit_user_navbar" inherit_id="website.layout" name="User Navbar Global">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <xpath expr="//head" position="inside">
            <!-- [@ANCHOR: xpath_rendering_navbar_head] -->

            <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_navbar_head] -->
            <!-- Not main_object.owner_user_id directly: that reads the owner's res.users row as
                 the visitor, a 403 for the public user and for other members. See
                 _user_websites_navbar_profile_user() on the owned mixin. -->
            <t t-set="profile_user" t-value="profile_user or (main_object._user_websites_navbar_profile_user() if main_object and 'owner_user_id' in main_object and 'user_websites_group_id' in main_object else False)"/>
            <t t-set="profile_group" t-value="profile_group or (main_object.user_websites_group_id if main_object and 'user_websites_group_id' in main_object else False)"/>
            <t t-set="resolved_slug" t-value="resolved_slug or (profile_user.website_slug if profile_user else (profile_group.website_slug if profile_group else False))"/>
            <t t-set="page_type" t-value="page_type or ('blog' if 'blog' in request.httprequest.path else 'home')"/>
            <t t-set="is_owner" t-value="is_owner or (profile_user and profile_user.id == uid) or (profile_group and uid in profile_group.member_ids.ids)"/>

            <!-- [@ANCHOR: user_websites:member_site_standalone_layout]
                 Verified by [@ANCHOR: test_member_site_has_no_hams_chrome]
                 A member or group site wears its own header (user_navbar) and footer
                 (member_site_footer), not hams.com's menu, banners and footer. member_site is
                 true for the site's own pages (website.page, blog.blog, blog.post, the site home
                 and blog index, whose main_object is the profile record) and for the owner tool
                 pages, which pass member_site=True themselves. website.layout's header and
                 footer honour no_header / no_footer. -->
            <t t-set="member_site" t-value="member_site or bool(resolved_slug and ((main_object and (main_object._name in ('website.page', 'blog.blog', 'blog.post') or main_object == profile_user or main_object == profile_group)) or request.httprequest.path.lower() == '/' + resolved_slug.lower() or request.httprequest.path.lower().startswith('/' + resolved_slug.lower() + '/')))"/>
            <t t-if="member_site">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
            </t>
            <t t-if="resolved_slug">
                <meta name="user_websites_slug" t-att-content="resolved_slug"/>
            </t>
        </xpath>

        <xpath expr="//header" position="after">
            <!-- [@ANCHOR: xpath_rendering_navbar] -->

            <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_navbar] -->
            <div id="user_websites_dropzone_navbar">
                <!-- [@ANCHOR: dropzone_navbar] -->

                <!-- Tested by [@ANCHOR: test_dropzone_navbar] -->
            </div>
            <t t-if="resolved_slug and member_site">
                <t t-call="user_websites.user_navbar"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_home_appeal" inherit_id="portal.portal_my_home" name="Portal My Home Appeal">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="before">
            <!-- [@ANCHOR: xpath_rendering_appeal] -->

            <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_appeal] -->
            <div id="user_websites_dropzone_templates">
                <!-- [@ANCHOR: dropzone_templates] -->

                <!-- Tested by [@ANCHOR: test_dropzone_templates] -->
            </div>
            <div class="container mt-4">
                <t t-if="user_id.is_suspended_from_websites">
                    <div class="alert alert-danger shadow-sm" role="alert">
                        <h4 class="alert-heading fw-bold"><i class="fa fa-ban me-2" aria-hidden="true"/> Account Suspended <a href="/user-websites/documentation#UX_SUBMIT_APPEAL" class="text-info fs-5 ms-1" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h4>
                        <p>We suspended your website and blog features because of community guideline violations. We also unpublished your content.</p>
                        <hr/>

                        <t t-set="existing_appeal" t-value="user_id.appeal_ids.filtered(lambda a: a.state == 'new')"/>

                        <t t-if="existing_appeal">
                            <p class="mb-0 text-dark fw-bold"><i class="fa fa-clock-o me-1" aria-hidden="true"/> We are currently reviewing your appeal.</p>
                        </t>
                        <t t-else="">
                            <form action="/website/submit_appeal" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="mb-3">
                                    <label for="reason" class="form-label fw-bold">Submit an Appeal (One-time only):</label>
                                    <textarea class="form-control" name="reason" id="reason" rows="3" required="required" placeholder="Please explain why your suspension should be lifted..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger">Submit Appeal</button>
                            </form>
                        </t>
                    </div>
                </t>
                
                <t t-set="suspended_groups" t-value="user_id.suspended_group_ids"/>
                <t t-foreach="suspended_groups" t-as="group">
                    <div class="alert alert-danger shadow-sm mt-3" role="alert">
                        <h4 class="alert-heading fw-bold"><i class="fa fa-ban me-2" aria-hidden="true"/> Group Suspended: <t t-out="group.name"/></h4>
                        <p>We suspended this group's website and blog features because of community guideline violations. We also unpublished the group's content.</p>
                        <hr/>

                        <t t-set="existing_appeal" t-value="group.appeal_ids.filtered(lambda a: a.state == 'new')"/>

                        <t t-if="existing_appeal">
                            <p class="mb-0 text-dark fw-bold"><i class="fa fa-clock-o me-1" aria-hidden="true"/> We are currently reviewing the group's appeal.</p>
                        </t>
                        <t t-else="">
                            <form action="/website/submit_appeal" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="group_id" t-att-value="group.id"/>
                                <div class="mb-3">
                                    <label t-attf-for="reason_#{group.id}" class="form-label fw-bold">Submit an Appeal for this Group (One-time only):</label>
                                    <textarea class="form-control" name="reason" t-attf-id="reason_#{group.id}" rows="3" required="required" placeholder="Please explain why the group's suspension should be lifted..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger">Submit Appeal</button>
                            </form>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <!-- [@ANCHOR: xpath_rendering_portal_docs] -->

            <!-- audit-ignore-xpath: Tested by [@ANCHOR: test_xpath_rendering_portal_docs] -->
            <div class="o_portal_doc_spinner col-12 col-md-6 col-lg-4 mb-4">
                <a href="/my/privacy" class="text-decoration-none d-flex flex-column h-100 p-3 border rounded shadow-sm bg-white">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa fa-shield fa-2x text-primary me-3" aria-hidden="true"/>
                        <h5 class="mb-0 fw-bold text-dark">Privacy &amp; Data</h5>
                    </div>
                    <div class="text-muted small">Manage your data, export content, and right to erasure.</div>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_privacy" name="My Privacy &amp; Data">
        <!-- Tested by [@ANCHOR: user_websites:test_tour_gdpr_privacy] -->
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Privacy &amp; Data</t>
            </t>
            <div class="container mt-4 mb-5">
                <div class="row">
                    <div class="col-12 col-lg-8 mx-auto">
                        <h2 class="fw-bold mb-4">Privacy &amp; Data Management</h2>

                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h4 class="card-title fw-bold"><i class="fa fa-download text-primary me-2" aria-hidden="true"/> Download My Data <a href="/user-websites/documentation#UX_GDPR_EXPORT" class="text-info fs-5 ms-1" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h4>
                                <p class="text-muted">Get a copy of your personal website pages and blog posts in a machine-readable JSON format for data portability purposes.</p>
                                <form action="/my/privacy/export" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-outline-primary"><i class="fa fa-download" aria-hidden="true"/> Export Data to JSON</button>
                                </form>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0 border-danger border border-1">
                            <div class="card-body">
                                <h4 class="card-title fw-bold text-danger"><i class="fa fa-trash text-danger me-2" aria-hidden="true"/> Right to Erasure <a href="/user-websites/documentation#UX_GDPR_ERASURE" class="text-info fs-5 ms-1" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h4>
                                <div class="alert alert-warning d-flex align-items-start" role="alert">
                                    <i class="fa fa-info-circle mt-1 me-2" aria-hidden="true"/>
                                    <div>Download a copy of your data above <strong>before</strong> erasing anything below. Once this runs, there is no way to get your content back.</div>
                                </div>
                                <div class="alert alert-danger d-flex align-items-start" role="alert" id="user_websites_erasure_ban_warning">
                                    <i class="fa fa-ban mt-1 me-2" aria-hidden="true"/>
                                    <div><strong>Once you erase your data you will be permanently banned from hams.com. This is irreversible.</strong> Your callsign is recorded, and you will never be able to enroll again.</div>
                                </div>
                                <p class="text-muted">Permanently delete all of your personal content -- website pages, blog posts, and the other personal content tied to your account -- remove you from the public community directory, and deactivate your account. Your name, address, callsign and license image stay in hams.com's permanent callbook of radio amateurs, and amateur radio contacts and other on-air activity records are never deleted, since they were already public over the air. <strong>This cannot be undone.</strong></p>
                                <form action="/my/privacy/delete_content" method="post" data-hams-confirm="Are you absolutely sure? This permanently deletes your content, deactivates your account, and permanently bans you from hams.com. This cannot be undone.">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-danger o_tour_erasure_initiate"><i class="fa fa-warning" aria-hidden="true"/> Erase My Account &amp; Content</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="privacy_erased" name="Privacy: Content Erased">
        <!-- Tested by [@ANCHOR: user_websites:test_privacy_erased_public_page] -->
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container mt-5 mb-5">
                    <div class="row">
                        <div class="col-12 col-lg-8 mx-auto">
                            <div id="user_websites_erasure_confirmed" class="alert alert-success" role="alert">
                                <h2 class="fw-bold">Your data has been erased</h2>
                                <p>We have permanently erased your personal website pages and blog posts from our servers, removed you from the public community directory, and deactivated your account. You are permanently banned from hams.com.</p>
                            </div>
                            <p>This is permanent and cannot be undone. Your name, address, callsign and license image remain in hams.com's permanent callbook of radio amateurs, and amateur radio contacts and other on-air activity records are not deleted, because they were already public over the air.</p>
                            <p>If you have questions about this erasure, please <a href="/contactus">contact us</a> and mention that your request concerns privacy (GDPR).</p>
                            <a href="/" class="btn btn-primary">Return to the home page</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="template_default_home" name="User Website Home Master Layout">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-call="website.layout">
            <div id="user_websites_dropzone_home_header">
                <!-- [@ANCHOR: dropzone_home_header] -->

                <!-- Tested by [@ANCHOR: test_dropzone_home_header] -->
            </div>

            <t t-out="0"/>

            <div id="user_websites_dropzone_home_footer">
                <!-- [@ANCHOR: dropzone_home_footer] -->

                <!-- Tested by [@ANCHOR: test_dropzone_home_footer] -->
            </div>
        </t>
    </template>

    <template id="blog_index" name="User Blog Index">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-call="website.layout">
            <div id="user_websites_dropzone_blog_header"></div>
            <div class="container mt-5">
                <t t-set="entity_name" t-value="profile_user.name if profile_user else (profile_group.name if profile_group else '')"/>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0"><t t-out="entity_name"/>'s Blog</h1>
                    <!-- Real gap found live 2026-09-29: this page never had any way for the
                         owner to add a post, see create_blog_post()'s own comment
                         (controllers/main.py) for the full story. -->
                    <t t-if="is_owner">
                        <div class="d-flex align-items-center">
                            <form t-attf-action="/#{resolved_slug}/create_blog_post" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-plus me-2" aria-hidden="true"/>New Post
                                </button>
                            </form>
                            <!-- Matches placeholder_page's own help_hash pattern (see below in this
                                 file): UX_CREATE_BLOG_POST is already documented in
                                 user_websites/docs/stories/personal_site.md, README.md,
                                 docs/journeys/onboarding.md and hams_shared/docs/modules/user_websites.md,
                                 this just wires the existing anchor into the new button's own template. -->
                            <a href="/user-websites/documentation#UX_CREATE_BLOG_POST" class="text-info fs-5 ms-1" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a>
                        </div>
                    </t>
                </div>
                <t t-if="not posts">
                    <p class="text-muted">No posts available yet.</p>
                </t>
                <t t-else="">
                    <t t-foreach="posts" t-as="post">
                        <div class="card mb-4 shadow-sm border-0">
                            <div class="card-body">
                                <h3 class="card-title fw-bold" t-out="post.name"/>
                                <p class="text-muted" t-if="post.subtitle" t-out="post.subtitle"/>
                                <span t-if="is_owner and not post.is_published" class="badge bg-warning text-dark ms-1">Draft</span>
                                <a t-attf-href="/blog/#{post.blog_id.id}/post/#{post.id}" class="btn btn-outline-primary mt-2">Read Post</a>
                                <!-- Real gap found live 2026-10-01 (night_shift_todo/high/
                                     personal-blog-owner-cannot-actually-edit-or-publish-their-own-new-post-0c44e7eb.md):
                                     the generic website-builder "Edit" toolbar never renders for this
                                     module's real target user (it's gated on website.group_website_designer,
                                     a global permission personal-site owners don't and structurally
                                     can't hold), so blog_post_edit() is this module's own, ownership-scoped
                                     replacement. -->
                                <a t-if="is_owner" t-attf-href="/blog_post/edit/#{post.id}" class="btn btn-outline-secondary mt-2 ms-1">
                                    <i class="fa fa-pencil me-1" aria-hidden="true"/>Edit
                                </a>
                            </div>
                        </div>
                    </t>
                </t>
                <div class="d-flex justify-content-center mt-4 mb-4">
                    <t t-call="website.pager"/>
                </div>
            </div>
            <div id="user_websites_dropzone_blog_footer"></div>
        </t>
    </template>

    <template id="blog_post_edit_form" name="Edit Blog Post">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_owner_can_edit_own_blog_post] -->

        <!-- [@ANCHOR: user_websites:UX_BLOG_POST_EDIT_FORM] -->
        <t t-call="website.layout">
            <div id="wrap" class="container mt-4 mb-5">
                <h1 class="h2">Edit Blog Post</h1>
                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <div t-if="request.params.get('error') == 'missing_fields'" class="alert alert-danger" role="alert">Please provide a title before saving.</div>
                        <div t-if="request.params.get('error') == 'too_long'" class="alert alert-danger" role="alert">That post is too long. Shorten it and save again.</div>
                        <form t-attf-action="/blog_post/edit/submit/#{post.id}" method="post" id="blog_post_edit_form" class="uw-editor-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold">Title</label>
                                <input type="text" class="form-control" id="name" name="name" required="1" maxlength="120" t-att-value="post.name"/>
                            </div>
                            <t t-call="user_websites.rich_editor">
                                <t t-set="editor_name" t-value="'content'"/>
                                <t t-set="editor_label" t-value="'Post body'"/>
                                <t t-set="editor_html" t-value="editor_initial"/>
                                <t t-set="upload_url" t-value="'/my/site/%s/image' % site_slug"/>
                            </t>
                            <div class="form-check mt-3 mb-4">
                                <input type="checkbox" class="form-check-input" id="is_published" name="is_published" t-att-checked="'checked' if post.is_published else None"/>
                                <label for="is_published" class="form-check-label fw-bold">Published (visible to the public)</label>
                            </div>
                            <button type="submit" class="btn btn-success">Save</button>
                            <a t-attf-href="/my/site/#{site_slug}" class="btn btn-outline-secondary ms-2">Back to my site</a>
                            <a t-if="post and post.id" t-attf-href="/my/site/#{site_slug}/post/#{post.id}/delete" class="btn btn-outline-danger ms-2">Delete</a>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="rich_editor" name="Member Site Rich Text Editor">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_owner_page_editor_renders_wysiwyg] -->
        <!-- [@ANCHOR: user_websites:UX_RICH_EDITOR]
             A WYSIWYG: members see and format the page, never markup. static/src/js/rich_editor.js
             fills the hidden field with the editor's HTML on submit; the server sanitizes it
             (models/member_html.py). editor_name, editor_label, editor_html and upload_url come
             from the calling template. -->
        <div class="uw-rich-editor mb-3" t-att-data-upload-url="upload_url" t-att-data-csrf="request.csrf_token()">
            <label t-attf-for="uw_editor_#{editor_name}" class="form-label fw-bold" t-out="editor_label"/>
            <div class="uw-toolbar btn-toolbar gap-1 mb-1 p-1 border rounded bg-light" role="toolbar" aria-label="Formatting" data-uw-toolbar="1">
                <div class="btn-group btn-group-sm" role="group" aria-label="Text style">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="bold" title="Bold (Ctrl+B)" aria-label="Bold"><i class="fa fa-bold" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="italic" title="Italic (Ctrl+I)" aria-label="Italic"><i class="fa fa-italic" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="underline" title="Underline (Ctrl+U)" aria-label="Underline"><i class="fa fa-underline" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="code" title="Inline code" aria-label="Inline code"><i class="fa fa-code" aria-hidden="true"/></button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Paragraph style">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="formatBlock" data-uw-arg="h2" title="Heading" aria-label="Heading">H2</button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="formatBlock" data-uw-arg="h3" title="Subheading" aria-label="Subheading">H3</button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="formatBlock" data-uw-arg="p" title="Normal paragraph" aria-label="Normal paragraph">P</button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="formatBlock" data-uw-arg="blockquote" title="Quote" aria-label="Block quote"><i class="fa fa-quote-right" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="formatBlock" data-uw-arg="pre" title="Code block" aria-label="Code block">{ }</button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Lists">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list"><i class="fa fa-list-ul" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="insertOrderedList" title="Numbered list" aria-label="Numbered list"><i class="fa fa-list-ol" aria-hidden="true"/></button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Alignment">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="justifyLeft" title="Align left" aria-label="Align left"><i class="fa fa-align-left" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="justifyCenter" title="Center" aria-label="Center"><i class="fa fa-align-center" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="justifyRight" title="Align right" aria-label="Align right"><i class="fa fa-align-right" aria-hidden="true"/></button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Insert">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="link" title="Link" aria-label="Insert link"><i class="fa fa-link" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="unlink" title="Remove link" aria-label="Remove link"><i class="fa fa-chain-broken" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="image" t-att-disabled="None if upload_url else 'disabled'" title="Insert image" aria-label="Insert image"><i class="fa fa-picture-o" aria-hidden="true"/></button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="History">
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><i class="fa fa-undo" aria-hidden="true"/></button>
                    <button type="button" class="btn btn-outline-secondary" data-uw-cmd="redo" title="Redo (Ctrl+Y)" aria-label="Redo"><i class="fa fa-repeat" aria-hidden="true"/></button>
                </div>
            </div>
            <div class="uw-link-bar input-group input-group-sm mb-1 d-none" role="group" aria-label="Link address">
                <label t-attf-for="uw_link_#{editor_name}" class="input-group-text">Link address</label>
                <input type="url" class="form-control" t-attf-id="uw_link_#{editor_name}" placeholder="https://example.com/" data-uw-link-input="1"/>
                <button type="button" class="btn btn-primary" data-uw-link-apply="1">Apply</button>
                <button type="button" class="btn btn-outline-secondary" data-uw-link-cancel="1">Cancel</button>
            </div>
            <input type="file" class="d-none" accept="image/jpeg,image/png,image/gif,image/webp" data-uw-file="1" aria-label="Choose an image to insert"/>
            <div class="uw-editor-area form-control" t-attf-id="uw_editor_#{editor_name}" contenteditable="true" role="textbox" aria-multiline="true" t-attf-aria-label="#{editor_label}" data-uw-area="1"><t t-out="editor_html"/></div>
            <div class="uw-editor-status small text-muted mt-1" role="status" aria-live="polite" data-uw-status="1"/>
            <input type="hidden" t-att-name="editor_name" data-uw-field="1"/>
            <noscript><p class="text-danger small">The editor needs JavaScript. Please enable it to write or change your content.</p></noscript>
        </div>
    </template>

    <template id="community_directory" name="Community Directory">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-12 text-center mb-5">
                        <h1 class="display-4 fw-bold">Community Directory <a href="/user-websites/documentation#UX_COMMUNITY_DIRECTORY" class="text-info fs-5 ms-2" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h1>
                        <p class="lead text-muted">Discover and connect with websites created by our amazing community members.</p>
                        <hr class="w-25 mx-auto"/>
                    </div>
                </div>
                <div class="row mt-4">
                    <t t-foreach="entries" t-as="entry">
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm border-0 hover-lift transition-all">
                                <div class="card-body p-4 text-center">
                                    <div class="mb-4">
                                        <img t-attf-src="/web/image/res.users/#{entry.user_id.id}/avatar_128?unique=#{entry.write_date and int(entry.write_date.timestamp()) or 0}" class="rounded-circle img-thumbnail shadow-sm p-1" style="width: 100px; height: 100px; object-fit: cover;" alt="User Avatar"/>
                                    </div>
                                    <h4 class="card-title fw-bold mb-2" t-out="entry.name"/>
                                    <p class="text-muted small mb-4">
                                        <span class="badge bg-light text-dark border py-2 px-3">
                                            <i class="fa fa-eye me-1 text-primary" aria-hidden="true"/> <t t-out="entry.view_count"/> Total Views
                                        </span>
                                    </p>
                                    <div class="d-grid gap-2">
                                        <a t-attf-href="/#{entry.website_slug}" class="btn btn-primary py-2 fw-bold">
                                            <i class="fa fa-home me-2" aria-hidden="true"/> Visit Home
                                        </a>
                                        <a t-attf-href="/#{entry.website_slug}/blog" class="btn btn-outline-secondary py-2 fw-bold">
                                            <i class="fa fa-pencil me-2" aria-hidden="true"/> View Blog
                                        </a>
                                    </div>
                                    <div id="user_websites_dropzone_directory_card" class="mt-3">
                                        <!-- [@ANCHOR: dropzone_directory_card] -->

                                        <!-- Tested by [@ANCHOR: test_dropzone_directory_card] -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <div t-if="not entries" class="col-12">
                        <p class="text-muted">No public websites available yet.</p>
                    </div>
                </div>
                <div class="d-flex justify-content-center mt-4 mb-4">
                    <t t-call="website.pager"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_violation_modal" name="Report Violation Modal">
        <!-- Tested by [@ANCHOR: user_websites:test_tour_frontend_misc] -->
        <div class="modal fade" id="reportViolationModal" tabindex="-1" role="dialog" aria-labelledby="reportViolationModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form action="/website/report_violation" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="url" t-att-value="request.httprequest.url"/>

                        <div class="modal-header">
                            <h2 class="modal-title h5 fw-bold" id="reportViolationModalLabel">Report Content Violation <a href="/user-websites/documentation#UX_REPORT_VIOLATION" class="text-info fs-5 ms-2" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            <div class="mb-3 d-none" aria-hidden="true">
                                <label for="website_honeypot">Leave this field empty if you are human:</label>
                                <input type="text" class="form-control" name="website_honeypot" id="website_honeypot" tabindex="-1" autocomplete="off"/>
                            </div>

                            <!-- [@ANCHOR: report_violation_guest_email_field]
                                 Verified by [@ANCHOR: test_report_violation_guest_email_stored]
                                 Ask an anonymous visitor for an address, stored as
                                 content.violation.report.reported_by_email. This used to test a
                                 bare "is_public_user" qcontext variable that no controller or
                                 website.layout ever sets, so it was always undefined, the field
                                 never rendered on any page, and every guest report was stored
                                 with no reporter address (found 2026-10-03 via the edge-cache
                                 tour). website.is_public_user() is Odoo's own check (the visitor
                                 is the website's public user), the same visitor
                                 cloudflare/models/ir_http.py lets a page be edge-cached for, so
                                 an edge-cached copy always carries the field. -->
                            <t t-if="website.is_public_user()">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Your Email Address:</label>
                                    <input type="email" class="form-control" name="email" id="email" required="required" placeholder="name@example.com"/>
                                </div>
                            </t>

                            <div class="mb-3">
                                <label for="description" class="form-label">Reason for reporting:</label>
                                <textarea class="form-control" name="description" id="description" rows="3" required="required"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Submit Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </template>

    <template id="report_violation_snippet" name="Report Violation Button">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <div class="text-center user-websites-report-container d-inline">
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reportViolationModal" t-att-data-url="request.httprequest.url">
                <i class="fa fa-flag" aria-hidden="true"/> Report Violation
            </button>
        </div>
    </template>

    <template id="unsubscribe_success" name="Unsubscription Success">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-call="website.layout">
            <div class="container mt-5 pt-5 text-center">
                <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
                    <div class="card-body p-5">
                        <i class="fa fa-check-circle text-success" style="font-size: 4rem;" aria-hidden="true"/>
                        <h2 class="mt-4 fw-bold">Unsubscribed Successfully</h2>
                        <p class="lead text-muted mt-3">
                            We successfully removed you from the mailing list for <strong t-out="record_name"/>.
                            You will no longer receive weekly digests for this site.
                        </p>
                        <a href="/" class="btn btn-primary mt-4">Return to Homepage</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="documentation_page" name="User Websites Documentation">
        <!-- audit-ignore-view: Tested by [@ANCHOR: test_user_websites_backend_views_rendering] -->
        <t t-call="website.layout">
            <div class="container mt-5 mb-5 shadow-sm p-5 bg-white rounded">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4 fw-bold">User Websites Module Documentation</h1>
                        <p class="lead text-muted"><strong>Version:</strong> Odoo 19 Community<br/>
                        <strong>Summary:</strong> Enables decentralized, multi-tenant content creation within a single Odoo instance, allowing users to build personal or group-managed websites and blogs.</p>
                        <hr class="mt-4 mb-4"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="placeholder_page" name="Website Placeholder">
        <!-- Tested by [@ANCHOR: user_websites:test_tour_create_site] -->
        <t t-call="website.layout">
            <div class="container mt-5 mb-5 text-center">
                <t t-set="entity_name" t-value="profile_user.name if profile_user else profile_group.name"/>
                <t t-set="entity_slug" t-value="resolved_slug"/>

                <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
                    <div class="card-body p-5">
                        <i class="fa fa-globe text-muted mb-3" style="font-size: 4rem;" aria-hidden="true"/>
                        <t t-if="is_owner">
                            <t t-set="help_hash" t-value="'#UX_CREATE_SITE' if page_type == 'home' else '#UX_CREATE_BLOG_POST'"/>
                            <h2 class="fw-bold">Welcome, <t t-out="entity_name"/>! <a t-attf-href="/user-websites/documentation#{help_hash}" class="text-info fs-5 ms-1" title="Help"><i class="fa fa-question-circle" aria-hidden="true"/></a></h2>
                            <p class="text-muted mt-3 mb-4">
                                Your <t t-out="page_type"/> has not been initialized yet. Click the button below to generate your initial layout and start editing.
                            </p>
                            <form t-attf-action="/#{entity_slug}/create_#{'site' if page_type == 'home' else 'blog'}" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-primary btn-lg o_tour_create_site_btn">
                                    <i t-attf-class="fa #{'fa-paint-brush' if page_type == 'home' else 'fa-pencil'} me-2" aria-hidden="true"/>
                                    Create Your <span style="text-transform: capitalize;"><t t-out="page_type"/></span>
                                </button>
                            </form>
                        </t>
                        <t t-else="">
                            <h2 class="fw-bold text-muted"><t t-out="entity_name"/></h2>
                            <p class="text-muted mt-3">
                                This user has not yet created their <t t-out="page_type"/>. Please check back later!
                            </p>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
