<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_dmarc_purge_service" model="res.groups">
            <field name="name">DMARC reports: purge service</field>
        </record>
    </data>
    <data>
        <!-- [@ANCHOR: hams_base:dmarc_purge_service_account] Reads and deletes DMARC reports, nothing else.
             Verified by [@ANCHOR: hams_base:test_dmarc_purge_drops_only_old_reports] -->
        <record id="user_dmarc_purge_service" model="res.users">
            <field name="name">DMARC report purge</field>
            <field name="login">dmarc_purge_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('hams_base.group_dmarc_purge_service')])]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="ir_cron_dmarc_purge" model="ir.cron">
            <!-- audit-ignore-cron: Tested by [@ANCHOR: hams_base:test_dmarc_purge_drops_only_old_reports] -->
            <field name="name">DMARC reports: purge old reports</field>
            <field name="model_id" ref="model_hams_base_dmarc_report"/>
            <field name="user_id" ref="hams_base.user_dmarc_purge_service"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_old_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
