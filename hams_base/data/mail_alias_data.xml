<odoo>
    <data noupdate="1">
        <!-- Route dmarc-reports@hams.com to hams_base.dmarc.report. The DMARC-report
             ingestion pipeline (message_new/process_dmarc_attachment/_parse_dmarc_xml) needs a
             real mail.alias routing to it. The suggested DNS rua= record cannot point at
             not-read@: mail_thread.py's own message_route override (this module) drops anything
             sent there (unless it's a recognized bounce/unsubscribe/vacation-reply) BEFORE Odoo's
             alias dispatch ever runs, so a real DMARC aggregate report would never reach the
             handler even with the alias wired to it. A dedicated alias avoids that collision
             entirely: "dmarc-reports" is not special-cased anywhere in message_route, so mail
             sent there falls straight through to super().message_route()'s normal alias
             resolution. See res_config_settings.py's own _compute_dns_records, which suggests this
             alias's address instead of not-read@. -->
        <record id="mail_alias_dmarc_reports" model="mail.alias">
            <field name="alias_name">dmarc-reports</field>
            <field name="alias_model_id" ref="hams_base.model_hams_base_dmarc_report"/>
            <field name="alias_contact">everyone</field>
        </record>
    </data>
</odoo>
