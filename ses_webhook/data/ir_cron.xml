<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- audit-ignore-cron: _cron_truncate_logs() deletes rows past a
             fixed retention cutoff in one bounded query (see
             models/ses_webhook_log.py), a housekeeping delete, not a
             per-item processing job with anything meaningful to
             re-trigger in batches. -->
        <record id="ir_cron_truncate_ses_webhook_logs" model="ir.cron">
            <field name="name">SES Webhook: Truncate Old Logs</field>
            <field name="model_id" ref="model_ses_webhook_log"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._cron_truncate_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
