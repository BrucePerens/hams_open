<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Odoo 19 refuses to run a server action for a user who lacks WRITE access to the action's model, unless the
             action names a group the user belongs to. This job runs as its own narrow service account, which has no write
             access to the model (by design: it only reads and deletes), so on hams.com it was refused every day ("Forbidden
             server action ... does not have access to ...", 7 consecutive failures by 2026-09-28) and never ran. Naming the
             service's own group on the job lets it run without widening the account's rights. This block is noupdate="0" so
             an upgrade applies the group to the existing row; an interval an administrator changed is reset too. -->
        <!-- audit-ignore-cron: _cron_truncate_logs() deletes rows past a
             fixed retention cutoff in one bounded query (see
             models/ses_webhook_log.py), a housekeeping delete, not a
             per-item processing job with anything meaningful to
             re-trigger in batches. -->
        <record id="ir_cron_truncate_ses_webhook_logs" model="ir.cron">
            <field name="name">SES Webhook: Truncate Old Logs</field>
            <field name="model_id" ref="model_ses_webhook_log"/>
            <field name="user_id" ref="user_ses_webhook_service_internal"/>
            <field name="group_ids" eval="[(6, 0, [ref('group_ses_webhook_service')])]"/>
            <field name="state">code</field>
            <field name="code">model._cron_truncate_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- audit-ignore-cron: _cron_truncate_pending_submissions() deletes
             rows past a fixed retention cutoff in one bounded query (see
             models/ses_webhook_pending_submission.py), a housekeeping
             delete, not a per-item processing job. -->
        <record id="ir_cron_truncate_ses_webhook_pending_submissions" model="ir.cron">
            <field name="name">SES Webhook: Truncate Old Pending Submissions</field>
            <field name="model_id" ref="model_ses_webhook_pending_submission"/>
            <field name="user_id" ref="user_ses_webhook_service_internal"/>
            <field name="group_ids" eval="[(6, 0, [ref('group_ses_webhook_service')])]"/>
            <field name="state">code</field>
            <field name="code">model._cron_truncate_pending_submissions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
