<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ir.rule and res.groups are required to stay in noupdate="1"
             (check_burn_list.py: CRITICAL SECURITY, no exemption).
             data/security_backfill.xml force-applies the 'groups' field
             below onto already-installed databases where these two rule
             ids predate this fix. -->
        <!-- privilege_id (not the older category_id, which Odoo 19's
             res.groups no longer has, confirmed against the real
             installed source): without it this group renders as an
             ordinary tickable checkbox in the res.users form's default
             "Other" list, so any admin editing a user's access could
             accidentally grant unconditional cross-tenant read of every
             tenant's secret_token with one misplaced click. Matches
             pager_duty's own shipping precedent for its analogous service
             group exactly (pager_duty/security/security.xml's
             group_pager_service/privilege_pager_duty). -->
        <record model="res.groups.privilege" id="privilege_ses_webhook">
            <field name="name">SES Webhook Service</field>
        </record>

        <record id="group_ses_webhook_service" model="res.groups">
            <field name="name">Service Account: SES Webhook Processor</field>
            <field name="privilege_id" ref="privilege_ses_webhook"/>
        </record>

        <!-- Multi-Company Rule for Domains: scoped to base.group_user so
             every real internal employee gets the identical isolation
             test_10_domain_multi_company_isolation already proves matters
             (base.group_system implies base.group_user in stock Odoo, so
             admin is unaffected too). A groups-less rule is unconditionally
             banned by this repo's own linter with no exemption. -->
        <record id="ses_webhook_domain_comp_rule" model="ir.rule">
            <field name="name">SES Webhook Domain Multi-Company</field>
            <field name="model_id" ref="model_ses_webhook_domain"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Second, separate rule on the dedicated service group, with an
             unconditional domain. Odoo ORs together the domains of every
             group-scoped ir.rule a user matches (ir_rule.py::_compute_domain),
             so a service account holding BOTH base.group_user and this
             group gets OR(company-scoped, TRUE) = TRUE, full cross-tenant
             access, no company enumerated anywhere. Deliberately does NOT
             exclude the service account from base.group_user (a first draft
             did): excluding it would also exempt it from every OTHER
             base.group_user-scoped rule in the system it happens to touch
             via message_process(), an unaudited privilege widening on
             unrelated models, not a narrowing. Matches pager_duty's own
             shipping precedent exactly
             (pager_duty/security/security.xml's pager_check_website_rule_svc). -->
        <record id="ses_webhook_domain_rule_svc" model="ir.rule">
            <field name="name">SES Webhook Domain Multi-Company Service</field>
            <field name="model_id" ref="model_ses_webhook_domain"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ses_webhook_service'))]"/>
        </record>

        <!-- Multi-Company Rule for Logs: same treatment as the domain rule
             above. -->
        <record id="ses_webhook_log_comp_rule" model="ir.rule">
            <field name="name">SES Webhook Log Multi-Company</field>
            <field name="model_id" ref="model_ses_webhook_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="ses_webhook_log_rule_svc" model="ir.rule">
            <field name="name">SES Webhook Log Multi-Company Service</field>
            <field name="model_id" ref="model_ses_webhook_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ses_webhook_service'))]"/>
        </record>

        <!-- Multi-Company Rule for Pending Submissions: same treatment as
             the domain/log rules above. -->
        <record id="ses_webhook_pending_submission_comp_rule" model="ir.rule">
            <field name="name">SES Webhook Pending Submission Multi-Company</field>
            <field name="model_id" ref="model_ses_webhook_pending_submission"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="ses_webhook_pending_submission_rule_svc" model="ir.rule">
            <field name="name">SES Webhook Pending Submission Multi-Company Service</field>
            <field name="model_id" ref="model_ses_webhook_pending_submission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ses_webhook_service'))]"/>
        </record>
    </data>
    <data>
        <!-- company_id/company_ids start at base.main_company only.
             ses_webhook_domain.py's create()/write() override grows
             company_ids automatically as tenants configure webhook
             domains, so this account's cross-tenant reach is never a
             hardcoded, tenant-count-dependent list. See that file's
             _sync_service_account_companies() for why: with_company()
             raises AccessError for a company outside the acting user's own
             company_ids when the environment isn't sudoed
             (odoo/orm/environments.py), which message_process() would hit
             otherwise. -->
        <record id="user_ses_webhook_service_internal" model="res.users">
            <field name="name">SES Webhook Service Internal</field>
            <field name="login">ses_webhook_service_internal</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
            <field name="notification_type">email</field>
            <field name="is_service_account" eval="True"/>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [ref('group_ses_webhook_service'), ref('base.group_user')])]"/>
        </record>
    </data>
</odoo>
